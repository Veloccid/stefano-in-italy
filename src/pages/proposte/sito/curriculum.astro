---
// Proposta F · Curriculum: esperienza e formazione in una pagina.
import SitoLayout from '../../../sito/SitoLayout.astro';
import { TAPPE, LINGUE_PARLATE, SPECIALITA, ZONE } from '../../../data/curriculum';
import { SITO } from '../../../config';
import Icona from '../../../components/Icona.astro';
import T from '../../../components/T.astro';
const esperienza = TAPPE.filter((t) => t.n <= 7);
const formazione = TAPPE.filter((t) => t.n >= 8);
---
<SitoLayout attiva="cv">
  <div class="wrap sf-pagina fc">
    <header class="sf-titolo">
      <T as="h1" k="cv.page.h" />
      <T as="p" k="intro.p1" />
    </header>
    <div class="fc-griglia">
      <div>
        <T as="h2" k="cv.esperienza" />
        <ol class="fc-linea">{esperienza.map((tp) => (
          <li><span class="fc-anni">{tp.anni}{tp.incorso && <> <T k="cv.now" /></>}</span><T as="h3" k={`cv.${tp.n}.h`} /><T as="p" k={`cv.${tp.n}.d`} /></li>
        ))}</ol>
        <T as="h2" k="cv.formazione" />
        <ol class="fc-linea">{formazione.map((tp) => (
          <li><span class="fc-anni">{tp.anni}</span><T as="h3" k={`cv.${tp.n}.h`} /><T as="p" k={`cv.${tp.n}.d`} /></li>
        ))}</ol>
      </div>
      <aside class="fc-lato">
        <T as="h3" k="f.lang" /><ul class="chips">{LINGUE_PARLATE.map((k) => <T as="li" k={k} />)}</ul>
        <T as="h3" k="f.spec" /><ul class="chips">{SPECIALITA.map((k) => <T as="li" k={k} />)}</ul>
        <T as="h3" k="f.where" /><ul class="chips">{ZONE.map((k) => <T as="li" k={k} />)}</ul>
        <a class="btn btn-wa js-wa fc-pdf" data-wa-testo="cv.pdf.wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener"><Icona nome="cv" /><T k="cv.pdf" /></a>
      </aside>
    </div>
  </div>
</SitoLayout>
<style is:global>
.fc-griglia{display:grid;grid-template-columns:1.4fr .8fr;gap:clamp(28px,5vw,64px)}
.fc h2{font-size:clamp(28px,3.4vw,40px);margin:8px 0 18px}
.fc-linea{list-style:none;margin:0 0 36px;padding:0;position:relative}
.fc-linea::before{content:"";position:absolute;left:8px;top:8px;bottom:8px;border-left:3px solid rgba(0,59,31,.18)}
.fc-linea li{position:relative;padding:0 0 26px 40px}
.fc-linea li::before{content:"";position:absolute;left:0;top:6px;width:19px;height:19px;border-radius:50%;background:var(--crema);border:4px solid var(--verde)}
.fc-anni{font-size:15px;font-weight:700;color:var(--terracotta)}
.fc-linea h3{font-size:24px;line-height:1.2;margin:2px 0 4px}
.fc-linea p{margin:0;color:var(--muted);max-width:56ch}
.fc-lato{background:var(--carta);border-radius:20px;padding:24px;display:grid;gap:10px;align-content:start;position:sticky;top:90px}
.fc-lato h3{font-size:22px;margin-top:8px}
.fc-lato .chips li{border-color:rgba(0,59,31,.3);font-size:15px}
.fc-pdf{margin-top:14px}
@media (max-width:860px){.fc-griglia{grid-template-columns:1fr}.fc-lato{position:static}}
</style>
