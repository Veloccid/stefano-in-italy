---
// Proposta F · Contatti.
import SitoLayout from '../../../sito/SitoLayout.astro';
import ContattiChiari from '../../../components/ContattiChiari.astro';
import { SITO } from '../../../config';
import { pagina } from '../../../sito/menu';
import Icona from '../../../components/Icona.astro';
import T from '../../../components/T.astro';
---
<SitoLayout attiva="contatti">
  <div class="wrap sf-pagina fk">
    <header class="sf-titolo"><T as="h1" k="c.h" /></header>
    <ContattiChiari cvHref={pagina('curriculum')} hKey="c.h2" pKey="c.p" />
    <a class="btn btn-linea fk-ig" href={SITO.instagram} target="_blank" rel="noopener"><Icona nome="ig" /><T k="c.ig" /></a>
  </div>
</SitoLayout>
<style is:global>
.fk .cc h2{font-size:clamp(28px,3.4vw,40px)}
.fk-ig{margin-top:28px}
</style>
