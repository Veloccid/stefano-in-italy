---
// Proposta F · Home: classica e asciutta, come la A. Presenta Stefano, non vende tour.
import SitoLayout from '../../../sito/SitoLayout.astro';
import { pagina } from '../../../sito/menu';
import { CITAZIONE } from '../../../data/recensioni';
import Icona from '../../../components/Icona.astro';
import T from '../../../components/T.astro';
const porte = [
  { p: 'servizi', k: 'm.servizi', d: 'h.servizi.d' },
  { p: 'dove', k: 'm.mappa', d: 'h.mappa.d' },
  { p: 'recensioni', k: 'm.recensioni', d: 'h.rec.d' },
];
---
<SitoLayout attiva="home">
  <section class="fh-hero">
    <img class="fh-stef" src="/img/stefano.webp" width="458" height="640" alt="Stefano, illustrated portrait" />
    <h1 class="fh-brand" aria-label="Stefano In Italy"><span class="k">S</span><span class="c">tefano</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">n</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">taly</span><span class="bang">!</span></h1>
    <T as="p" class="fh-ruolo" k="tag.role" />
    <T as="p" class="fh-intro" k="h.intro" />
    <a class="btn fh-btn" href={pagina('curriculum')}><T k="h.scopri" /><Icona nome="freccia" /></a>
  </section>

  <section class="wrap fh-porte">
    <T as="h2" k="h.porte" />
    <div class="fh-griglia">
      {porte.map((x) => (
        <a class="fh-porta" href={pagina(x.p)}>
          <T as="strong" k={x.k} />
          <T as="span" k={x.d} />
          <span class="fh-apri"><T k="h.apri" /> →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="fh-cit">
    <div class="wrap">
      <div class="fh-stelle" aria-label="5/5">{[1, 2, 3, 4, 5].map(() => <Icona nome="stella" />)}</div>
      <blockquote>“{CITAZIONE.testo}”</blockquote>
      <p><T k="rev.quote.src" /> · <a href={pagina('recensioni')}><T k="m.recensioni" /> →</a></p>
    </div>
  </section>
</SitoLayout>
<style is:global>
@property --q { syntax: '<number>'; inherits: true; initial-value: 0; }
.fh-hero{background:var(--verde);color:var(--crema);display:grid;justify-items:center;text-align:center;gap:14px;padding:clamp(32px,6vw,72px) var(--pad) clamp(48px,7vw,88px)}
.fh-stef{width:clamp(120px,14vw,170px);height:auto;-webkit-mask-image:linear-gradient(#000 78%,transparent);mask-image:linear-gradient(#000 78%,transparent)}
.fh-brand{margin:0;font-size:clamp(46px,8vw,104px);white-space:nowrap;display:inline-flex;align-items:baseline;animation:fhUna 1.4s 1.2s cubic-bezier(.6,0,.3,1) forwards}
.fh-brand .c{display:inline-block;overflow:hidden;vertical-align:baseline;padding-bottom:.22em;margin-bottom:-.22em;max-width:calc(var(--w,4em) * (1 - var(--q)));opacity:calc(1 - var(--q) * 2.5)}
.fh-brand .bang{display:inline-block;overflow:hidden;max-width:calc(.36em * var(--q));opacity:var(--q)}
@keyframes fhUna{to{--q:1}}
.fh-ruolo{margin:0;font-size:15px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#E3B458}
.fh-intro{margin:0;max-width:46ch;font-size:clamp(19px,2vw,22px);color:#E7EEE3}
.fh-btn{background:var(--crema);color:var(--verde);margin-top:8px;font-size:18px}
.fh-btn svg{width:20px;height:20px}
.fh-porte{padding-top:clamp(48px,7vw,88px);padding-bottom:clamp(48px,7vw,88px)}
.fh-porte h2{font-size:clamp(32px,4.4vw,52px);margin-bottom:24px}
.fh-griglia{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.fh-porta{display:grid;gap:8px;align-content:start;background:#fff;border:2px solid rgba(0,59,31,.12);border-radius:18px;padding:24px;text-decoration:none;transition:border-color .2s,transform .2s}
.fh-porta:hover,.fh-porta:focus-visible{border-color:var(--verde);transform:translateY(-3px)}
.fh-porta strong{font:400 28px/1.1 var(--f-display)}
.fh-porta span{color:var(--muted)}
.fh-porta .fh-apri{color:var(--terracotta);font-weight:700;margin-top:6px}
.fh-cit{background:var(--carta);padding:clamp(48px,7vw,88px) 0}
.fh-stelle{display:flex;gap:4px;color:var(--ocra)}
.fh-stelle svg{width:26px;height:26px}
.fh-cit blockquote{margin:14px 0 10px;font:400 clamp(26px,3.6vw,44px)/1.2 var(--f-display);max-width:28ch}
.fh-cit p{margin:0;color:var(--muted);font-weight:600}
@media (max-width:820px){.fh-griglia{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){.fh-brand{animation:none}}
</style>
<script>
  const b = document.querySelector<HTMLElement>('.fh-brand');
  if (b) {
    const misura = () => { const fs = parseFloat(getComputedStyle(b).fontSize); b.querySelectorAll<HTMLElement>('.c').forEach((el) => { el.style.maxWidth = 'none'; const w = el.scrollWidth / fs; el.style.maxWidth = ''; el.style.setProperty('--w', w + 0.02 + 'em'); }); };
    misura(); document.fonts?.ready.then(misura); addEventListener('resize', misura);
  }
</script>
