---
// Proposta F · Recensioni: 24 posti. In cima una frase dalle recensioni vere che cambia ogni 4 secondi.
import SitoLayout from '../../../sito/SitoLayout.astro';
import CartaRec from '../../../sito/CartaRec.astro';
import { RECENSIONI_SITO, CITAZIONI } from '../../../data/recensioni';
import { pagina } from '../../../sito/menu';
import Icona from '../../../components/Icona.astro';
import T from '../../../components/T.astro';
---
<SitoLayout attiva="recensioni">
  <div class="wrap sf-pagina fr-alto">
    <header class="sf-titolo">
      <div class="fr-stelle" aria-label="5/5">{[1, 2, 3, 4, 5].map(() => <Icona nome="stella" />)}</div>
      <T as="h1" k="r.h" />
      <T as="p" k="r.p" />
    </header>
    <div class="fr-cit" aria-live="polite">
      {CITAZIONI.map((c, i) => (
        <figure class:list={['fr-frase', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <blockquote>“{c.testo}”</blockquote>
          <figcaption>{c.chi}</figcaption>
        </figure>
      ))}
      <div class="fr-punti" aria-hidden="true">{CITAZIONI.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}</div>
    </div>
  </div>
  <div class="fr-scorri" id="frScorri" tabindex="0" aria-label="Reviews" data-i18n-aria="nav.reviews">
    <div class="fr-binario">{RECENSIONI_SITO.map((r, i) => <CartaRec r={r} n={i + 1} />)}</div>
  </div>
  <div class="wrap fr-sotto">
    <div class="fr-barra" aria-hidden="true"><span></span></div>
    <div class="fr-frecce">
      <button type="button" id="frPrima" aria-label="Previous" data-i18n-aria="rv.prev"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" id="frDopo" aria-label="Next" data-i18n-aria="rv.next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </div>
  <div class="wrap fr-fondo">
    <T as="p" class="fr-nota" k="fid.tutte" />
    <p class="fr-lascia"><a class="btn btn-linea" href={pagina('contatti')}><T k="r.lascia" /> →</a></p>
  </div>
</SitoLayout>
<style is:global>
.sf-pagina.fr-alto{padding-bottom:36px}
.fr-stelle{display:flex;gap:4px;color:var(--ocra)}
.fr-stelle svg{width:28px;height:28px}
.fr-cit{position:relative;display:grid;margin:0;background:var(--verde);color:var(--crema);border-radius:22px;padding:clamp(26px,4vw,44px) clamp(24px,4vw,44px) 56px}
.fr-frase{grid-area:1/1;margin:0;opacity:0;transform:translateY(10px);transition:opacity .7s ease,transform .7s ease;pointer-events:none}
.fr-frase.on{opacity:1;transform:none}
.fr-frase blockquote{margin:0 0 12px;font:400 clamp(26px,3.4vw,42px)/1.22 var(--f-display);max-width:30ch}
.fr-frase figcaption{color:#C9D6C6;font-weight:600}
.fr-punti{position:absolute;left:clamp(24px,4vw,44px);bottom:24px;display:flex;gap:8px}
.fr-punti span{width:8px;height:8px;border-radius:50%;background:rgba(254,246,235,.35);transition:background-color .4s,width .4s}
.fr-punti span.on{background:#E3B458;width:22px;border-radius:4px}
.fr-scorri{--pad2:max(var(--pad),calc((100% - var(--max))/2 + var(--pad)));overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-padding-inline:var(--pad2);scrollbar-width:none;cursor:grab}
.fr-scorri::-webkit-scrollbar{display:none}
.fr-scorri.drag{scroll-snap-type:none;cursor:grabbing;user-select:none}
.fr-scorri.drag img{pointer-events:none}
.fr-binario{display:flex;align-items:flex-start;gap:20px;width:max-content;padding:4px var(--pad2) 8px}
.fr-binario .cr{flex:none;width:min(72vw,280px);scroll-snap-align:start}
.fr-sotto{display:flex;align-items:center;gap:20px;margin-top:20px}
.fr-barra{flex:1;height:3px;border-radius:3px;background:rgba(0,59,31,.14);position:relative;overflow:hidden}
.fr-barra span{position:absolute;top:0;bottom:0;left:var(--l,0%);width:var(--w,20%);border-radius:3px;background:var(--ocra)}
.fr-frecce{display:flex;gap:10px}
.fr-frecce button{width:46px;height:46px;border-radius:50%;border:2px solid var(--ink);background:transparent;color:var(--ink);display:grid;place-items:center;cursor:pointer}
.fr-frecce button:hover:not(:disabled){background:var(--ink);color:var(--bg)}
.fr-frecce button:disabled{opacity:.3;cursor:default}
.fr-frecce svg{width:20px;height:20px;stroke:currentColor;stroke-width:2.4;fill:none;stroke-linecap:round;stroke-linejoin:round}
.fr-fondo{padding-bottom:clamp(56px,8vw,96px);margin-top:16px}
.fr-nota{color:var(--muted);font-size:15px;margin:8px 0 0}
.fr-lascia{margin-top:24px}
@media (prefers-reduced-motion:reduce){.fr-frase{transition:none;transform:none}}
</style>
<script>
  const frasi = [...document.querySelectorAll<HTMLElement>('.fr-frase')];
  const punti = [...document.querySelectorAll<HTMLElement>('.fr-punti span')];
  // scorrimento orizzontale: frecce, barra e trascinamento col mouse
  const v = document.getElementById('frScorri')!, prima = document.getElementById('frPrima') as HTMLButtonElement, dopo = document.getElementById('frDopo') as HTMLButtonElement;
  const barra = document.querySelector<HTMLElement>('.fr-barra span')!;
  const lento = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth') as ScrollBehavior;
  const passo = () => { const c = v.querySelector('.cr'); return c ? c.getBoundingClientRect().width + 20 : 300; };
  const misura = () => {
    const max = v.scrollWidth - v.clientWidth, x = v.scrollLeft, vis = v.scrollWidth ? v.clientWidth / v.scrollWidth : 1;
    barra.style.setProperty('--w', (Math.min(1, vis) * 100).toFixed(2) + '%');
    barra.style.setProperty('--l', (max > 0 ? (x / max) * (1 - vis) * 100 : 0).toFixed(2) + '%');
    prima.disabled = x <= 2; dopo.disabled = x >= max - 2;
  };
  v.addEventListener('scroll', misura, { passive: true }); addEventListener('resize', misura); addEventListener('load', misura);
  prima.addEventListener('click', () => v.scrollBy({ left: -passo() * 2, behavior: lento() }));
  dopo.addEventListener('click', () => v.scrollBy({ left: passo() * 2, behavior: lento() }));
  let dx0: number | null = null, l0 = 0, mosso = false;
  v.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' || e.button !== 0) return; dx0 = e.clientX; l0 = v.scrollLeft; mosso = false; });
  addEventListener('pointermove', (e) => { if (dx0 === null) return; const d = e.clientX - dx0; if (Math.abs(d) > 4) { mosso = true; v.classList.add('drag'); } if (mosso) v.scrollLeft = l0 - d; });
  addEventListener('pointerup', () => { if (dx0 === null) return; dx0 = null; if (mosso) { v.classList.remove('drag'); const st = passo(); v.scrollTo({ left: Math.round(v.scrollLeft / st) * st, behavior: 'smooth' }); } });
  v.addEventListener('click', (e) => { if (mosso) { e.preventDefault(); mosso = false; } }, true);
  v.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { e.preventDefault(); dopo.click(); } if (e.key === 'ArrowLeft') { e.preventDefault(); prima.click(); } });
  misura();

  if (frasi.length > 1) {
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      frasi[i].classList.remove('on'); frasi[i].setAttribute('aria-hidden', 'true'); punti[i].classList.remove('on');
      i = (i + 1) % frasi.length;
      frasi[i].classList.add('on'); frasi[i].removeAttribute('aria-hidden'); punti[i].classList.add('on');
    }, 4000);
  }
</script>
