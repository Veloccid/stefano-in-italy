---
// Proposta F · Dove lavoro: mappa in 3D (si inclina, si disegna da sola), niente zoom.
// Ogni città ha un'etichetta grande da toccare; Stefano "salta" sulla città scelta e a fianco compaiono i tour.
import SitoLayout from '../../../sito/SitoLayout.astro';
import { ITALIA_PATH } from '../../../data/italia';
import { NOMI, NOMI_KEY, xy } from '../../../data/zone';
import { PUNTI_MAPPA, INQUADRA as Q } from '../../../data/tour';
import { SITO } from '../../../config';
import { TESTI } from '../../../data/testi';
import Icona from '../../../components/Icona.astro';
import T from '../../../components/T.astro';
const nome = (id: string) => (NOMI_KEY[id] ? TESTI[NOMI_KEY[id]].en : NOMI[id]);
const pc = (x: number, y: number) => `left:${(((x - Q.x) / Q.w) * 100).toFixed(2)}%;top:${(((y - Q.y) / Q.h) * 100).toFixed(2)}%`;
const regioneK = { toscana: 'mp.toscana', lazio: 'mp.lazio', puglia: 'mp.puglia', veneto: 'mp.veneto', piemonte: 'mp.piemonte', liguria: 'mp.liguria' } as const;
const [sx, sy] = xy('sora');
---
<SitoLayout attiva="mappa">
  <div class="wrap sf-pagina">
    <header class="sf-titolo"><T as="h1" k="mp.h" /><T as="p" k="mp.p" /></header>
    <div class="m3">
      <div class="m3-palco">
        <div class="m3-inclina" id="m3Inclina" data-q={JSON.stringify(Q)}>
          <svg class="m3-svg" viewBox={`${Q.x} ${Q.y} ${Q.w} ${Q.h}`} aria-hidden="true">
            <defs>
              <pattern id="m3Onde" width="22" height="12" patternUnits="userSpaceOnUse"><path d="M0 8 Q5.5 4 11 8 T22 8" fill="none" stroke="#B9CDBB" stroke-width=".8" /></pattern>
              <radialGradient id="m3Luce"><stop offset="0" stop-color="#E3B458" stop-opacity=".7" /><stop offset="1" stop-color="#E3B458" stop-opacity="0" /></radialGradient>
            </defs>
            <rect x={Q.x - 50} y={Q.y - 50} width={Q.w + 100} height={Q.h + 100} class="m3-mare" />
            <rect x={Q.x - 50} y={Q.y - 50} width={Q.w + 100} height={Q.h + 100} fill="url(#m3Onde)" opacity=".7" />
            <text class="m3-mar" x="150" y="330">Mar Tirreno</text>
            <text class="m3-mar" x="400" y="200">Mar Adriatico</text>
            <path class="m3-spessore" d={ITALIA_PATH} transform="translate(1.5 3)" />
            <path class="m3-terra" d={ITALIA_PATH} pathLength="1" />
            {PUNTI_MAPPA.map((p) => { const [x, y] = xy(p.id); return <line class="m3-filo" data-filo={p.id} x1={x} y1={y} x2={p.et[0]} y2={p.et[1]} />; })}
            {PUNTI_MAPPA.map((p, i) => { const [x, y] = xy(p.id); return (
              <g class:list={['m3-pin', `m3-${p.tipo}`, `m3-r-${p.regione}`]} data-punto={p.id} transform={`translate(${x} ${y})`} style={`--d:${1.5 + i * 0.1}s`}>
                <circle class="m3-luce" r="26" fill="url(#m3Luce)" />
                <circle class="m3-onda" r="6" />
                <circle class="m3-c" r="5" />
                <circle class="m3-tocco" r="14" />
              </g>
            ); })}
          </svg>
          <p class="m3-gruppo" style={pc(566, 128)}><T k="mp.puglia" /> <T class="m3-badge" k="mp.recente" /></p>
          {PUNTI_MAPPA.map((p, i) => (
            <button type="button" class:list={['m3-et', `m3-et-${p.tipo}`, `m3-et-${p.regione}`]} data-punto={p.id} style={`${pc(p.et[0], p.et[1])};--d:${1.7 + i * 0.1}s`} aria-pressed="false">
              {p.casa && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z" /></svg>}
              <span data-i18n={NOMI_KEY[p.id]}>{nome(p.id)}</span>
            </button>
          ))}
          <div class="m3-stef" id="m3Stef" style={pc(sx, sy)} aria-hidden="true"><div class="m3-stef-salto"><img src="/img/stefano.webp" alt="" width="458" height="640" /></div><span class="m3-ombra"></span></div>
        </div>
      </div>

      <aside class="m3-pannello" aria-live="polite">
        <div class="m3-info m3-vuoto" data-info="">
          <svg class="m3-mano" viewBox="0 0 70 48" aria-hidden="true"><path d="M64 8 C 50 40, 26 44, 8 30"/><path d="M18 24 L7 29 L14 40"/></svg>
          <T as="h2" k="mp.scegli" />
          <T as="p" k="mp.scegli.d" />
          <div class="m3-rapidi">
            {PUNTI_MAPPA.map((p) => <button type="button" data-punto={p.id}><span data-i18n={NOMI_KEY[p.id]}>{nome(p.id)}</span></button>)}
          </div>
        </div>
        {PUNTI_MAPPA.map((p) => (
          <div class="m3-info" data-info={p.id} hidden>
            <p class="m3-tipo"><T k={p.casa ? 'mp.base' : regioneK[p.regione]} /></p>
            <h2 data-i18n={NOMI_KEY[p.id]}>{nome(p.id)}</h2>
            {p.casa && <T as="p" class="m3-casa" k="mp.casa" />}
            <ul>
              {p.tour.map((t) => (
                <li>
                  <T as="h3" k={t.t} />
                  {t.anni && <p class="m3-meta">{t.anni} · {t.con}</p>}
                  <T as="p" k={t.d} />
                  {t.daCompletare && <span class="sf-provv" lang="it">dettagli da completare con Stefano</span>}
                </li>
              ))}
            </ul>
            {p.casa && <a class="btn btn-wa js-wa m3-chiedi" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener" data-wa-testo="mp.chiedi.wa"><Icona nome="wa" /><T k="mp.chiedi" /></a>}
          </div>
        ))}
      </aside>
    </div>
  </div>
</SitoLayout>
<style is:global>
.m3{display:grid;grid-template-columns:1.45fr .85fr;gap:clamp(20px,3vw,40px);align-items:start}
.m3-palco{perspective:1300px;perspective-origin:50% 0%;padding:8px 0 24px}
.m3-inclina{position:relative;aspect-ratio:600/400;border-radius:24px;transform-style:preserve-3d;transform:rotateX(var(--rx,24deg)) rotateY(var(--ry,0deg)) rotateZ(-1.5deg);transform-origin:50% 60%;transition:transform .9s cubic-bezier(.2,.8,.2,1);box-shadow:0 2px 0 #0B4A2B,0 4px 0 #0B4A2B,0 6px 0 #0B4A2B,0 8px 0 #0B4A2B,0 40px 50px -10px rgba(0,40,20,.35);animation:m3Arriva 1.4s cubic-bezier(.2,.8,.2,1) backwards}
@keyframes m3Arriva{from{transform:rotateX(60deg) rotateZ(-8deg) translateY(40px);opacity:0}}
.m3-svg{position:absolute;inset:0;width:100%;height:100%;display:block;border-radius:24px;overflow:hidden}
.m3-mare{fill:#DCE8DE}
.m3-mar{font:italic 400 13px var(--f-display);fill:#7FA08A;letter-spacing:.12em}
.m3-spessore{fill:#2C5A40;opacity:0;animation:m3Riempi .8s 1.3s ease forwards}
.m3-terra{fill:#FBF3E4;stroke:var(--verde);stroke-width:.9;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;fill-opacity:0;animation:m3Disegna 2s .2s cubic-bezier(.6,0,.3,1) forwards,m3Riempi .8s 1.3s ease forwards}
@keyframes m3Disegna{to{stroke-dashoffset:0}}
@keyframes m3Riempi{to{fill-opacity:1;opacity:1}}
.m3-filo{stroke:var(--verde);stroke-width:1;stroke-dasharray:2 3;opacity:0;animation:m3Riempi .6s 2s forwards}
.m3-filo.on{stroke:var(--terracotta);stroke-width:1.6;stroke-dasharray:none}
.m3-pin{cursor:pointer;opacity:0;animation:m3Riempi .4s var(--d) forwards}
.m3-c{fill:var(--verde);stroke:#fff;stroke-width:2}
.m3-r-puglia .m3-c{fill:#E3B458;stroke:var(--verde)}
.m3-base .m3-c{fill:var(--terracotta)}
.m3-tocco{fill:transparent}
.m3-luce{opacity:0;transition:opacity .3s}
.m3-pin.on .m3-luce{opacity:1}
.m3-onda{fill:none;stroke:#E3B458;stroke-width:1.5;transform-box:fill-box;transform-origin:center;opacity:0}
.m3-r-puglia .m3-onda,.m3-pin.on .m3-onda{animation:m3Onda 2.2s calc(var(--d) + .5s) infinite}
@keyframes m3Onda{0%{opacity:.9;transform:scale(.8)}100%{opacity:0;transform:scale(3)}}
.m3-gruppo{position:absolute;transform:translate(-50%,-50%);margin:0;white-space:nowrap;font:700 12px/1 var(--f-sans);letter-spacing:.12em;text-transform:uppercase;color:var(--verde);display:flex;gap:6px;align-items:center}
.m3-badge{background:var(--terracotta);color:var(--crema);padding:4px 7px;border-radius:999px;font-size:10px}
.m3-et{position:absolute;transform:translate(-50%,-50%) translateZ(0);appearance:none;display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:0 14px;border-radius:999px;border:2px solid var(--verde);background:#fff;color:var(--verde);font:700 15px/1 var(--f-sans);white-space:nowrap;cursor:pointer;box-shadow:0 3px 0 rgba(0,59,31,.25),0 8px 16px rgba(0,40,20,.12);opacity:0;animation:m3Et .5s var(--d) cubic-bezier(.3,1.5,.5,1) forwards;transition:background-color .2s,color .2s,box-shadow .2s}
@keyframes m3Et{from{opacity:0;transform:translate(-50%,-30%) scale(.7)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
.m3-et svg{width:16px;height:16px;fill:currentColor}
.m3-et-puglia{border-color:#C98E2B}
.m3-et-base{border-color:var(--terracotta);color:var(--terracotta)}
.m3-et:hover,.m3-et:focus-visible{background:#FFF7E6;box-shadow:0 4px 0 rgba(0,59,31,.3),0 12px 20px rgba(0,40,20,.18)}
.m3-et[aria-pressed="true"]{background:var(--verde);color:var(--crema);border-color:var(--verde)}
.m3-et-base[aria-pressed="true"]{background:var(--terracotta);border-color:var(--terracotta)}
.m3-stef{position:absolute;width:0;height:0;pointer-events:none;transition:left .9s cubic-bezier(.45,0,.3,1),top .9s cubic-bezier(.45,0,.3,1);z-index:2}
.m3-stef-salto{position:absolute;left:-23px;bottom:10px;width:46px;height:46px;border-radius:50%;background:var(--crema);border:3px solid var(--verde);transform-origin:50% 130%;box-shadow:0 6px 10px rgba(0,30,15,.3)}
.m3-stef-salto::after{content:"";position:absolute;left:50%;bottom:-11px;margin-left:-7px;width:14px;height:10px;background:var(--verde);clip-path:polygon(0 0,100% 0,50% 100%)}
.m3-stef img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 4%;border-radius:50%}
.m3-ombra{position:absolute;left:-12px;top:-3px;width:24px;height:6px;border-radius:50%;background:rgba(0,30,15,.3)}
.m3-stef.hop .m3-stef-salto{animation:m3Salto .9s cubic-bezier(.45,0,.3,1)}
.m3-stef.hop .m3-ombra{animation:m3Ombra .9s cubic-bezier(.45,0,.3,1)}
@keyframes m3Salto{0%{transform:translateY(0) scale(1,1)}10%{transform:translateY(0) scale(1.1,.85)}50%{transform:translateY(-70px) scale(.95,1.05)}90%{transform:translateY(0) scale(1.1,.88)}100%{transform:translateY(0) scale(1,1)}}
@keyframes m3Ombra{50%{transform:scale(.5);opacity:.4}}
.m3-pannello{scroll-margin-top:84px;background:#fff;border:1px solid rgba(0,59,31,.14);border-radius:22px;padding:clamp(20px,2.4vw,28px);box-shadow:0 14px 34px rgba(0,40,20,.08);position:sticky;top:96px}
.m3-info:not([hidden]){animation:m3Info .45s cubic-bezier(.2,.8,.2,1)}
@keyframes m3Info{from{opacity:0;transform:translateY(12px)}}
.m3-mano{width:64px;height:44px;stroke:var(--terracotta);fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.m3-vuoto h2{font-size:clamp(28px,3vw,36px);margin:4px 0 8px}
.m3-vuoto p{margin:0 0 16px;color:var(--muted)}
.m3-rapidi{display:flex;flex-wrap:wrap;gap:8px}
.m3-rapidi button{appearance:none;border:1.5px solid rgba(0,59,31,.3);background:transparent;color:var(--verde);border-radius:999px;padding:9px 14px;font:600 15px/1 var(--f-sans);cursor:pointer}
.m3-rapidi button:hover{background:var(--carta)}
.m3-tipo{margin:0;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--terracotta)}
.m3-info h2{font-size:clamp(32px,3.4vw,42px);margin:2px 0 12px}
.m3-casa{margin:0 0 14px;font:400 21px/1.35 var(--f-display);color:var(--verde);background:var(--carta);border-radius:14px;padding:14px 16px}
.m3-info ul{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.m3-info li{border-top:1px solid rgba(0,59,31,.14);padding-top:12px}
.m3-info h3{font-size:22px}
.m3-meta{margin:2px 0 4px;font-size:15px;font-weight:700;color:var(--muted)}
.m3-info li p:not(.m3-meta){margin:0;font-size:16px}
.m3-cv{display:inline-block;margin-top:16px;font-weight:700}
.m3-chiedi{margin-top:18px;width:100%;justify-content:center}
@media (max-width:980px){
  .m3{grid-template-columns:1fr}
  .m3-pannello{position:static}
  .m3-palco{padding-bottom:8px}
  .m3-et{min-height:32px;padding:0 10px;font-size:13px}
  .m3-gruppo{font-size:10px}
  .m3-mar{font-size:11px}
}
@media (max-width:520px){.m3-et{min-height:28px;padding:0 8px;font-size:12px;gap:4px;border-width:1.5px}.m3-et svg{width:13px;height:13px}.m3-stef-salto{width:34px;height:34px;left:-17px;border-width:2px}.m3-gruppo .m3-badge{display:none}}
@media (prefers-reduced-motion:reduce){
  .m3-inclina,.m3-terra,.m3-spessore,.m3-pin,.m3-et,.m3-filo{animation:none;opacity:1;fill-opacity:1;stroke-dashoffset:0}
  .m3-inclina{transition:none}
  .m3-stef{transition:none}
  .m3-stef.hop .m3-stef-salto,.m3-stef.hop .m3-ombra{animation:none}
}
</style>
<script>
  const inc = document.getElementById('m3Inclina');
  if (inc) {
    const Q = JSON.parse(inc.dataset.q!);
    const stef = document.getElementById('m3Stef')!;
    const pins = [...inc.querySelectorAll<SVGGElement>('.m3-pin')];
    const etichette = [...inc.querySelectorAll<HTMLButtonElement>('.m3-et')];
    const fili = [...inc.querySelectorAll<SVGLineElement>('.m3-filo')];
    const infos = [...document.querySelectorAll<HTMLElement>('.m3-info')];
    const pannello = document.querySelector<HTMLElement>('.m3-pannello')!;
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const base = () => (innerWidth <= 980 ? 16 : 24);
    const pos = (id: string) => { const t = pins.find((p) => p.dataset.punto === id)!.transform.baseVal[0].matrix; return [(t.e - Q.x) / Q.w, (t.f - Q.y) / Q.h]; };
    let attuale = '';
    const scegli = (id: string, daMappa = true) => {
      if (id === attuale) return;
      attuale = id;
      pins.forEach((p) => p.classList.toggle('on', p.dataset.punto === id));
      fili.forEach((f) => f.classList.toggle('on', f.dataset.filo === id));
      etichette.forEach((e) => e.setAttribute('aria-pressed', String(e.dataset.punto === id)));
      infos.forEach((i) => (i.hidden = i.dataset.info !== id));
      // Stefano salta sulla città scelta e la mappa si gira un po' verso di lei
      const [x, y] = pos(id);
      stef.style.left = (x * 100).toFixed(2) + '%'; stef.style.top = (y * 100).toFixed(2) + '%';
      stef.classList.remove('hop'); void stef.offsetWidth; stef.classList.add('hop');
      if (!ridotto) { inc.style.setProperty('--ry', ((0.5 - x) * 14).toFixed(1) + 'deg'); inc.style.setProperty('--rx', (base() + (y - 0.5) * 8).toFixed(1) + 'deg'); }
      if (innerWidth <= 980 && daMappa) setTimeout(() => pannello.scrollIntoView({ behavior: ridotto ? 'auto' : 'smooth', block: 'start' }), 650);
    };
    etichette.forEach((e) => e.addEventListener('click', () => scegli(e.dataset.punto!)));
    document.querySelectorAll<HTMLButtonElement>('.m3-rapidi button').forEach((b) => b.addEventListener('click', () => scegli(b.dataset.punto!, false)));
    // un tocco vicino a un punto della mappa sceglie la città più vicina (comodo per le città della Puglia)
    inc.addEventListener('click', (e) => {
      if ((e.target as Element).closest('.m3-et')) return;
      let meglio = '', d = 44;
      pins.forEach((p) => { const r = p.querySelector('.m3-c')!.getBoundingClientRect(); const dd = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2)); if (dd < d) { d = dd; meglio = p.dataset.punto!; } });
      if (meglio) scegli(meglio);
    });
    // leggera inclinazione che segue il mouse
    if (!ridotto && matchMedia('(hover: hover)').matches) {
      const palco = document.querySelector<HTMLElement>('.m3-palco')!;
      palco.addEventListener('pointermove', (e) => {
        if (attuale) return;
        const r = palco.getBoundingClientRect();
        inc.style.setProperty('--ry', (((e.clientX - r.left) / r.width - 0.5) * 10).toFixed(1) + 'deg');
        inc.style.setProperty('--rx', (base() - ((e.clientY - r.top) / r.height - 0.5) * 10).toFixed(1) + 'deg');
      });
      palco.addEventListener('pointerleave', () => { if (!attuale) { inc.style.setProperty('--ry', '0deg'); inc.style.setProperty('--rx', base() + 'deg'); } });
    }
  }
</script>
