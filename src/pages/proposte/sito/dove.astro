---
// Proposta F · Dove lavoro: mappa da trascinare e ingrandire; si tocca un posto e compaiono i tour fatti lì.
import SitoLayout from '../../../sito/SitoLayout.astro';
import { ITALIA_PATH, ITALIA_W, ITALIA_H } from '../../../data/italia';
import { NOMI, NOMI_KEY, xy } from '../../../data/zone';
import { PUNTI_MAPPA } from '../../../data/tour';
import { pagina } from '../../../sito/menu';
import T from '../../../components/T.astro';
const nome = (id: string) => (NOMI_KEY[id] ? 'Florence' : NOMI[id]);
const tipoK = { tour: 'mp.tour', formazione: 'mp.formazione', base: 'mp.base' } as const;
---
<SitoLayout attiva="mappa">
  <div class="wrap sf-pagina">
    <header class="sf-titolo"><T as="h1" k="mp.h" /><T as="p" k="mp.p" /></header>
    <div class="fm">
      <div class="fm-carta">
        <svg id="fmSvg" viewBox={`0 0 ${ITALIA_W} ${ITALIA_H}`} role="img" aria-label="Map of Italy">
          <rect x="-2000" y="-2000" width="5000" height="5000" class="fm-mare" />
          <path d={ITALIA_PATH} class="fm-terra" />
          {PUNTI_MAPPA.map((p) => { const [x, y] = xy(p.id); return (
            <g class:list={['fm-pin', `fm-${p.tipo}`]} data-punto={p.id} transform={`translate(${x} ${y})`} role="button" tabindex="0" aria-label={NOMI[p.id]}>
              <g class="fm-s"><circle class="fm-alone" r="13" /><circle class="fm-c" r="7" /><text x="12" y="5" data-i18n={NOMI_KEY[p.id]}>{nome(p.id)}</text></g>
            </g>
          ); })}
        </svg>
        <div class="fm-zoom">
          <button type="button" data-z="in" aria-label="Zoom in" data-i18n-aria="mp.zoomin">+</button>
          <button type="button" data-z="out" aria-label="Zoom out" data-i18n-aria="mp.zoomout">−</button>
          <button type="button" data-z="reset" class="fm-tutta"><T k="mp.reset" /></button>
        </div>
      </div>
      <aside class="fm-pannello" aria-live="polite">
        <div class="fm-vuoto" data-info=""><T as="p" k="mp.scegli" /></div>
        {PUNTI_MAPPA.map((p) => (
          <div class="fm-info" data-info={p.id} hidden>
            <p class="fm-tipo"><T k={tipoK[p.tipo]} /></p>
            <h2 data-i18n={NOMI_KEY[p.id]}>{nome(p.id)}</h2>
            <ul>
              {p.tour.map((t) => (
                <li>
                  <T as="h3" k={t.t} />
                  <p class="fm-meta">{t.anni} · {t.con}</p>
                  <T as="p" k={t.d} />
                  {t.daCompletare && <span class="sf-provv" lang="it">dettagli da completare con Stefano</span>}
                </li>
              ))}
            </ul>
            <a class="fm-cv" href={pagina('curriculum')}><T k="mp.cv" /> →</a>
          </div>
        ))}
      </aside>
    </div>
  </div>
</SitoLayout>
<style is:global>
.fm{display:grid;grid-template-columns:1.3fr .9fr;gap:24px;align-items:start}
.fm-carta{position:relative;border-radius:22px;overflow:hidden;border:1px solid rgba(0,59,31,.15);height:min(74vh,720px);background:#E9EFE6}
#fmSvg{width:100%;height:100%;display:block;touch-action:none;cursor:grab;--k:1}
#fmSvg.trascina{cursor:grabbing}
.fm-mare{fill:#E9EFE6}
.fm-terra{fill:#FBF3E4;stroke:var(--verde);stroke-width:calc(1.4px * var(--k));stroke-linejoin:round}
.fm-pin{cursor:pointer}
.fm-pin:focus{outline:none}
.fm-s{transform:scale(var(--k))}
.fm-c{fill:var(--verde);stroke:#fff;stroke-width:2.5}
.fm-formazione .fm-c{fill:#fff;stroke:var(--verde);stroke-width:3}
.fm-base .fm-c{fill:var(--terracotta)}
.fm-alone{fill:#E3B458;opacity:0;transition:opacity .25s}
.fm-pin:hover .fm-alone,.fm-pin:focus-visible .fm-alone,.fm-pin.on .fm-alone{opacity:.55}
.fm-pin text{font:700 15px var(--f-sans);fill:var(--verde);paint-order:stroke;stroke:#FBF3E4;stroke-width:4px;opacity:0;transition:opacity .2s;pointer-events:none}
#fmSvg.vicino .fm-pin text,.fm-pin:hover text,.fm-pin.on text,.fm-pin:focus-visible text{opacity:1}
.fm-zoom{position:absolute;right:12px;top:12px;display:grid;gap:6px}
.fm-zoom button{appearance:none;min-width:44px;height:44px;border-radius:12px;border:1px solid rgba(0,59,31,.2);background:#fff;color:var(--verde);font:700 22px/1 var(--f-sans);cursor:pointer;box-shadow:0 4px 10px rgba(0,40,20,.12)}
.fm-zoom .fm-tutta{font-size:13px;padding:0 10px}
.fm-pannello{background:#fff;border:1px solid rgba(0,59,31,.14);border-radius:20px;padding:22px;max-height:min(74vh,720px);overflow:auto}
.fm-vuoto p{margin:0;color:var(--muted);font:400 24px/1.3 var(--f-display)}
.fm-tipo{margin:0;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--terracotta)}
.fm-info h2{font-size:36px;margin:2px 0 12px}
.fm-info ul{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.fm-info li{border-top:1px solid rgba(0,59,31,.14);padding-top:12px}
.fm-info h3{font-size:22px}
.fm-meta{margin:2px 0 4px;font-size:15px;font-weight:700;color:var(--muted)}
.fm-info li p:not(.fm-meta){margin:0;font-size:16px}
.fm-cv{display:inline-block;margin-top:16px;font-weight:700}
@media (max-width:900px){.fm{grid-template-columns:1fr}.fm-carta{height:62vh}.fm-pannello{max-height:none}}
</style>
<script>
  const svg = document.getElementById('fmSvg') as unknown as SVGSVGElement | null;
  if (svg) {
    const W = 600, H = 720, MIN = 70;
    const pins = [...svg.querySelectorAll<SVGGElement>('.fm-pin')];
    const infos = [...document.querySelectorAll<HTMLElement>('[data-info]')];
    let vb = [0, 0, W, H];
    const adatta = () => { // stessa proporzione del riquadro, così la mappa non si deforma
      const r = svg.getBoundingClientRect(); const ar = r.width / r.height;
      let [x, y, w, h] = vb; const cx = x + w / 2, cy = y + h / 2;
      if (w / h > ar) h = w / ar; else w = h * ar;
      vb = [cx - w / 2, cy - h / 2, w, h];
    };
    const disegna = () => {
      svg.setAttribute('viewBox', vb.map((n) => n.toFixed(1)).join(' '));
      const k = Math.min(vb[2] / W, vb[3] / H); svg.style.setProperty('--k', k.toFixed(3));
      svg.classList.toggle('vicino', k < 0.55);
    };
    const tutta = () => { vb = [0, 0, W, H]; adatta(); disegna(); };
    const zoom = (f: number, cx = vb[0] + vb[2] / 2, cy = vb[1] + vb[3] / 2) => {
      const w = Math.min(Math.max(vb[2] * f, MIN), W * 1.6), h = (w * vb[3]) / vb[2];
      vb = [cx - ((cx - vb[0]) * w) / vb[2], cy - ((cy - vb[1]) * h) / vb[3], w, h]; disegna();
    };
    const puntoSvg = (cx: number, cy: number) => { const r = svg.getBoundingClientRect(); return [vb[0] + ((cx - r.left) / r.width) * vb[2], vb[1] + ((cy - r.top) / r.height) * vb[3]]; };
    // trascinamento con mouse e dito, pizzico per ingrandire
    const dita = new Map<number, { x: number; y: number }>();
    let mosso = false, distIniziale = 0, wIniziale = 0;
    svg.addEventListener('pointerdown', (e) => { svg.setPointerCapture(e.pointerId); dita.set(e.pointerId, { x: e.clientX, y: e.clientY }); mosso = false; if (dita.size === 2) { const [a, b] = [...dita.values()]; distIniziale = Math.hypot(a.x - b.x, a.y - b.y); wIniziale = vb[2]; } });
    svg.addEventListener('pointermove', (e) => {
      const prima = dita.get(e.pointerId); if (!prima) return;
      if (dita.size === 1) {
        const dx = e.clientX - prima.x, dy = e.clientY - prima.y;
        if (Math.abs(dx) + Math.abs(dy) > 2) { mosso = true; svg.classList.add('trascina'); }
        const r = svg.getBoundingClientRect();
        vb[0] -= (dx / r.width) * vb[2]; vb[1] -= (dy / r.height) * vb[3]; disegna();
      }
      dita.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (dita.size === 2) {
        mosso = true; const [a, b] = [...dita.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y);
        const [cx, cy] = puntoSvg((a.x + b.x) / 2, (a.y + b.y) / 2);
        zoom((wIniziale * (distIniziale / d)) / vb[2], cx, cy);
      }
    });
    const fine = (e: PointerEvent) => { dita.delete(e.pointerId); if (!dita.size) svg.classList.remove('trascina'); };
    svg.addEventListener('pointerup', fine); svg.addEventListener('pointercancel', fine);
    svg.addEventListener('wheel', (e) => { if (!(e.ctrlKey || e.metaKey)) return; e.preventDefault(); const [cx, cy] = puntoSvg(e.clientX, e.clientY); zoom(e.deltaY > 0 ? 1.15 : 0.87, cx, cy); }, { passive: false });
    svg.addEventListener('dblclick', (e) => { const [cx, cy] = puntoSvg(e.clientX, e.clientY); zoom(0.6, cx, cy); });
    document.querySelectorAll<HTMLButtonElement>('.fm-zoom button').forEach((b) => b.addEventListener('click', () => { if (b.dataset.z === 'in') zoom(0.7); else if (b.dataset.z === 'out') zoom(1.4); else tutta(); }));
    // scelta di un posto
    const scegli = (id: string) => {
      pins.forEach((p) => p.classList.toggle('on', p.dataset.punto === id));
      infos.forEach((i) => (i.hidden = i.dataset.info !== id));
      if (innerWidth <= 900) document.querySelector('.fm-pannello')!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    pins.forEach((p) => {
      p.addEventListener('click', () => { if (!mosso) scegli(p.dataset.punto!); });
      p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); scegli(p.dataset.punto!); } });
    });
    addEventListener('resize', () => { adatta(); disegna(); });
    tutta();
  }
</script>
