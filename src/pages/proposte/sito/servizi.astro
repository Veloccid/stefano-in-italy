---
// Proposta F · Servizi: si sceglie subito la strada giusta, agenzie e tour operator oppure privati, gruppi, scuole ed enti.
import SitoLayout from '../../../sito/SitoLayout.astro';
import { pagina } from '../../../sito/menu';
import T from '../../../components/T.astro';
const strade = [
  { p: 'servizi/tour-operator', n: 'A', tab: 'sv.to.tab', q: 'sv.to.q', d: 'sv.to.d', scura: true },
  { p: 'servizi/gruppi', n: 'B', tab: 'sv.pr.tab', q: 'sv.pr.q', d: 'sv.pr.d', scura: false },
];
---
<SitoLayout attiva="servizi">
  <div class="wrap sf-pagina">
    <header class="sf-titolo"><T as="h1" k="s.h" /><T as="p" k="s.intro" /></header>
    <div class="sv-strade">
      {strade.map((s) => (
        <a class:list={['sv-strada', { scura: s.scura }]} href={pagina(s.p)}>
          <span class="sv-tab"><span class="sv-sn">{s.n}</span><T k={s.tab} /></span>
          <T as="strong" k={s.q} />
          <T as="span" class="sv-d" k={s.d} />
          <span class="sv-vai"><T k="sv.apri" /> →</span>
        </a>
      ))}
    </div>
  </div>
</SitoLayout>
<style is:global>
.sv-strade{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.sv-strada{display:grid;gap:14px;align-content:start;min-height:360px;padding:clamp(24px,3vw,40px);border-radius:24px;text-decoration:none;background:#fff;border:2px solid rgba(0,59,31,.15);color:var(--verde);transition:transform .25s,box-shadow .25s}
.sv-strada.scura{background:var(--verde);color:var(--crema);border-color:var(--verde)}
.sv-strada:hover,.sv-strada:focus-visible{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,40,20,.16)}
.sv-tab{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.sv-strada strong{font:400 clamp(30px,3.4vw,44px)/1.1 var(--f-display)}
.sv-d{font-size:17px;opacity:.85}
.sv-vai{margin-top:auto;font-weight:700;color:var(--terracotta)}
.sv-strada.scura .sv-vai{color:#E3B458}
@media (max-width:760px){.sv-strade{grid-template-columns:1fr}.sv-strada{min-height:0}}
</style>
