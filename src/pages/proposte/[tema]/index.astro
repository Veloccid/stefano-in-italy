---
import Layout from '../../../layouts/Layout.astro';
import { percorsiTemi, type Tema } from '../../../temi';
import Cammino from '../../../proposte/cammino/Home.astro';
import Essenziale from '../../../proposte/essenziale/Home.astro';
import Rivista from '../../../proposte/rivista/Home.astro';
import Verde from '../../../proposte/verde/Home.astro';
import Percorso from '../../../proposte/percorso/Home.astro';

export const getStaticPaths = percorsiTemi;
const { tema } = Astro.props as { tema: Tema };
const HOME = { cammino: Cammino, essenziale: Essenziale, rivista: Rivista, verde: Verde, percorso: Percorso } as const;
const Home = HOME[tema.id as keyof typeof HOME];
---
<Layout tema={tema}>
  <Home />
</Layout>
