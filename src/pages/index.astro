---
// Home provvisoria: solo la scritta che diventa SII!, finché Stefano non sceglie la proposta.
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import { SITO } from '../config';
---
<Layout titoloKey="wip.title" contatti={false}>
  <main id="contenuto" class="wip">
    <h1 class="wip-brand" aria-label="Stefano In Italy"><span class="k">S</span><span class="c">tefano</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">n</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">taly</span><span class="bang">!</span></h1>
    <p class="wip-stato"><T k="wip.kicker" /> · <a href={SITO.instagram} target="_blank" rel="noopener">{SITO.instagramHandle}</a></p>
  </main>
</Layout>

<style is:global>
@property --q { syntax: '<number>'; inherits: true; initial-value: 0; }
html:has(.wip) body{background:var(--verde);color:var(--crema)}
.wip{min-height:100dvh;display:grid;place-content:center;justify-items:center;text-align:center;gap:20px;padding:24px}
.wip-brand{margin:0;font:400 clamp(52px,13vw,150px)/1 var(--f-display);white-space:nowrap;display:inline-flex;align-items:baseline;letter-spacing:-.01em;animation:morph 8s cubic-bezier(.7,0,.25,1) infinite .8s}
.wip-brand .c{display:inline-block;overflow:hidden;vertical-align:baseline;padding-bottom:.22em;margin-bottom:-.22em;max-width:calc(var(--w,4em) * (1 - var(--q)));opacity:calc(1 - var(--q) * 2.5);filter:blur(calc(var(--q) * 6px))}
.wip-brand .bang{display:inline-block;overflow:hidden;max-width:calc(.36em * var(--q));opacity:var(--q);transform:translateY(calc((1 - var(--q)) * -.4em)) rotate(calc((1 - var(--q)) * 30deg))}
@keyframes morph{0%,30%{--q:0}48%,80%{--q:1}96%,100%{--q:0}}
.wip-stato{margin:0;font-size:12px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:rgba(254,246,235,.55)}
.wip-stato a{color:inherit;text-decoration:none;text-transform:none;letter-spacing:.06em}
.wip-stato a:hover{color:var(--crema)}
@media (prefers-reduced-motion:reduce){.wip-brand{animation:none}}
</style>

<script>
  const brand = document.querySelector<HTMLElement>('.wip-brand');
  if (brand) {
    const misura = () => {
      const fs = parseFloat(getComputedStyle(brand).fontSize);
      brand.querySelectorAll<HTMLElement>('.c').forEach((el) => {
        el.style.maxWidth = 'none'; const w = el.scrollWidth / fs; el.style.maxWidth = ''; el.style.setProperty('--w', w + 0.02 + 'em');
      });
    };
    misura(); document.fonts?.ready.then(misura); addEventListener('resize', misura);
  }
</script>
