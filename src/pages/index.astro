---
// Home provvisoria: solo la scritta che diventa SII!, finché Stefano non sceglie la proposta.
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import { SITO } from '../config';
---
<Layout titoloKey="wip.title" contatti={false}>
  <main id="contenuto" class="wip">
    <div class="wip-faccia" aria-hidden="true"><div class="wip-annuisce"><img id="wipStef" src="/img/stefano.webp" width="458" height="640" alt="" /></div></div>
    <h1 class="wip-brand" aria-label="Stefano In Italy"><span class="k">S</span><span class="c">tefano</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">n</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">taly</span><span class="bang">!</span></h1>
    <p class="wip-stato"><T k="wip.kicker" /> · <a href={SITO.instagram} target="_blank" rel="noopener">{SITO.instagramHandle}</a></p>
  </main>
</Layout>

<style is:global>
@property --q { syntax: '<number>'; inherits: true; initial-value: 0; }
html:has(.wip) body{background:var(--verde);color:var(--crema)}
.wip{min-height:100dvh;display:grid;place-content:center;justify-items:center;text-align:center;gap:20px;padding:24px;--ciclo:8s}
/* la faccia: entra dal basso, guarda verso il puntatore e annuisce quando compare SII! */
.wip-faccia{width:clamp(120px,16vw,190px);margin-bottom:-6px;animation:entra-faccia 1.1s cubic-bezier(.2,.8,.2,1) both;-webkit-mask-image:linear-gradient(#000 72%,transparent);mask-image:linear-gradient(#000 72%,transparent)}
.wip-annuisce{transform-origin:50% 90%;animation:annuisce var(--ciclo) ease-in-out infinite .8s}
.wip-faccia img{width:100%;height:auto;transform:scaleX(var(--verso,1)) rotate(calc(var(--inclina,0) * 1deg));transition:transform .5s cubic-bezier(.3,.7,.2,1)}
@keyframes entra-faccia{from{opacity:0;transform:translateY(60px)}}
@keyframes annuisce{0%,44%{transform:none}48%{transform:translateY(-14px) rotate(-3deg)}52%{transform:translateY(2px)}56%{transform:translateY(-10px) rotate(2deg)}60%{transform:translateY(0)}64%,100%{transform:none}}
.wip-brand,.wip-stato{animation-fill-mode:both}
.wip-stato{animation:entra-testo .9s .5s cubic-bezier(.2,.8,.2,1) both}
@keyframes entra-testo{from{opacity:0;transform:translateY(16px)}}
.wip-brand{margin:0;font:400 clamp(52px,13vw,150px)/1 var(--f-display);white-space:nowrap;display:inline-flex;align-items:baseline;letter-spacing:-.01em;animation:morph var(--ciclo) cubic-bezier(.7,0,.25,1) infinite .8s,entra-testo .9s .25s cubic-bezier(.2,.8,.2,1) both}
.wip-brand .c{display:inline-block;overflow:hidden;vertical-align:baseline;padding-bottom:.22em;margin-bottom:-.22em;max-width:calc(var(--w,4em) * (1 - var(--q)));opacity:calc(1 - var(--q) * 2.5);filter:blur(calc(var(--q) * 6px))}
.wip-brand .bang{display:inline-block;overflow:hidden;max-width:calc(.36em * var(--q));opacity:var(--q);transform:translateY(calc((1 - var(--q)) * -.4em)) rotate(calc((1 - var(--q)) * 30deg))}
@keyframes morph{0%,30%{--q:0}48%,80%{--q:1}96%,100%{--q:0}}
.wip-stato{margin:0;font-size:12px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:rgba(254,246,235,.55)}
.wip-stato a{color:inherit;text-decoration:none;text-transform:none;letter-spacing:.06em}
.wip-stato a:hover{color:var(--crema)}
@media (prefers-reduced-motion:reduce){.wip-brand,.wip-faccia,.wip-annuisce,.wip-stato{animation:none}}
</style>

<script>
  const brand = document.querySelector<HTMLElement>('.wip-brand');
  if (brand) {
    const misura = () => {
      const fs = parseFloat(getComputedStyle(brand).fontSize);
      brand.querySelectorAll<HTMLElement>('.c').forEach((el) => {
        el.style.maxWidth = 'none'; const w = el.scrollWidth / fs; el.style.maxWidth = ''; el.style.setProperty('--w', w + 0.02 + 'em');
      });
    };
    misura(); document.fonts?.ready.then(misura); addEventListener('resize', misura);
    // Stefano guarda verso il puntatore (nel disegno originale guarda a sinistra)
    const img = document.getElementById('wipStef')!;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      addEventListener('pointermove', (e) => {
        const r = img.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        const dx = e.clientX - cx, dy = e.clientY - cy;
        img.style.setProperty('--verso', dx > 0 ? '-1' : '1');
        img.style.setProperty('--inclina', String(Math.max(-8, Math.min(8, (dy / innerHeight) * 18 * (dx > 0 ? -1 : 1)))));
      });
      // su telefono si gira da solo ogni tanto
      if (matchMedia('(hover: none)').matches) setInterval(() => img.style.setProperty('--verso', img.style.getPropertyValue('--verso') === '-1' ? '1' : '-1'), 4000);
    }
  }
</script>
