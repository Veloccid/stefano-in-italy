---
// Proposta F: struttura comune delle pagine (menu, lingue, piè di pagina, WhatsApp sempre a portata).
import Layout from '../layouts/Layout.astro';
import Lingue from '../components/Lingue.astro';
import Icona from '../components/Icona.astro';
import T from '../components/T.astro';
import { SITO } from '../config';
import { temaDa } from '../temi';
import { MENU, pagina } from './menu';
interface Props { attiva: string; titoloKey?: string; home?: boolean }
const { attiva, titoloKey, home = false } = Astro.props;
const tema = temaDa('sito');
---
<Layout tema={tema} titoloKey={titoloKey} contatti={false}>
  <div class:list={['sf', { 'sf-home': home }]}>
    <header class="sf-testa">
      <a class="sf-logo" href={pagina('')} aria-label="Stefano In Italy, home">SII!</a>
      <nav class="sf-nav" aria-label="Menu" data-i18n-aria="m.menu">
        {MENU.map((m) => <a href={pagina(m.p)} aria-current={m.id === attiva ? 'page' : undefined}><T k={m.k} /></a>)}
      </nav>
      <Lingue class="su-verde" />
      <details class="sf-menu-mob">
        <summary><span class="sr" data-i18n="m.menu">Menu</span><span class="sf-burger" aria-hidden="true"></span></summary>
        <nav aria-label="Menu" data-i18n-aria="m.menu">
          {MENU.map((m) => <a href={pagina(m.p)} aria-current={m.id === attiva ? 'page' : undefined}><T k={m.k} /></a>)}
        </nav>
      </details>
    </header>
    <main id="contenuto" class="sf-main"><slot /></main>
    <footer class="sf-piede">
      <div class="wrap sf-piede-in">
        <div>
          <p class="sf-piede-logo">SII!</p>
          <T as="p" k="foot" />
        </div>
        <nav aria-label="Menu" data-i18n-aria="m.menu">{MENU.map((m) => <a href={pagina(m.p)}><T k={m.k} /></a>)}</nav>
        <div class="sf-piede-ct">
          <a href={`mailto:${SITO.email}`}>{SITO.email}</a>
          <a class="js-wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener">WhatsApp +39 346 760 3667</a>
          <a href={SITO.instagram} target="_blank" rel="noopener">{SITO.instagramHandle}</a>
        </div>
      </div>
      <p class="wrap sf-legale"><T k="foot.legale" /></p>
    </footer>
    <a class="wa-fisso js-wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener" aria-label="Message Stefano on WhatsApp" data-i18n-aria="wa.aria"><Icona nome="wa" /></a>
  </div>
</Layout>
<style is:global>
.sf{font-size:18px;line-height:1.6;min-height:100dvh;display:flex;flex-direction:column}
.sf-main{flex:1}
.sf-testa{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:20px;padding:12px var(--pad);background:var(--verde);color:var(--crema)}
.sf-logo{font:400 30px/1 var(--f-display);text-decoration:none;margin-right:auto}
.sf-nav{display:flex;gap:4px}
.sf-nav a{text-decoration:none;font-weight:600;font-size:16px;padding:8px 12px;border-radius:999px}
.sf-nav a:hover{background:rgba(254,246,235,.12)}
.sf-nav a[aria-current="page"]{background:var(--crema);color:var(--verde)}
.sf-menu-mob{display:none;position:relative}
.sf-menu-mob summary{list-style:none;cursor:pointer;width:46px;height:46px;border-radius:50%;border:1.5px solid rgba(254,246,235,.5);display:grid;place-items:center}
.sf-menu-mob summary::-webkit-details-marker{display:none}
.sf-burger,.sf-burger::before,.sf-burger::after{display:block;width:20px;height:2px;background:currentColor;border-radius:2px;position:relative}
.sf-burger::before,.sf-burger::after{content:"";position:absolute;left:0}
.sf-burger::before{top:-6px}.sf-burger::after{top:6px}
.sf-menu-mob[open] .sf-burger{background:transparent}
.sf-menu-mob[open] .sf-burger::before{top:0;transform:rotate(45deg)}
.sf-menu-mob[open] .sf-burger::after{top:0;transform:rotate(-45deg)}
.sf-menu-mob nav{position:absolute;right:0;top:calc(100% + 10px);background:var(--crema);color:var(--verde);border-radius:16px;padding:8px;min-width:230px;display:grid;box-shadow:0 18px 40px rgba(0,25,12,.3)}
.sf-menu-mob nav a{text-decoration:none;font-weight:600;padding:12px 14px;border-radius:10px;font-size:18px}
.sf-menu-mob nav a[aria-current="page"]{background:var(--verde);color:var(--crema)}
.sf-piede{background:var(--verde);color:var(--crema);padding:48px 0 100px;margin-top:0}
.sf-piede-in{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:28px}
.sf-piede-logo{font:400 40px/1 var(--f-display);margin:0 0 8px}
.sf-piede p{color:#C9D6C6;margin:0}
.sf-piede nav,.sf-piede-ct{display:grid;gap:6px;align-content:start}
.sf-piede a{color:var(--crema);text-decoration:none}
.sf-piede a:hover{text-decoration:underline}
.sf-legale{margin-top:28px!important;font-size:14px;opacity:.7}
.sf-pagina{padding-top:clamp(36px,6vw,72px);padding-bottom:clamp(56px,8vw,96px)}
.sf-titolo{display:grid;gap:10px;margin-bottom:clamp(28px,4vw,44px)}
.sf-titolo h1{font-size:clamp(40px,6vw,72px)}
.sf-titolo p{margin:0;color:var(--muted);max-width:60ch;font-size:1.08em}
.sf-provv{display:inline-block;font-size:13px;font-weight:700;background:rgba(201,142,43,.25);padding:3px 8px;border-radius:4px;color:var(--verde)}
/* in home la testata è trasparente sopra il verde: il logo è la scritta grande che vola in alto */
.sf-home .sf-testa{position:fixed;left:0;right:0;top:0;background:rgba(0,59,31,var(--p,0));padding-top:calc(12px + env(safe-area-inset-top,0px))}
.sf-home .sf-logo{visibility:hidden}
.sf-home:has(.sf-menu-mob[open]) #stef{opacity:0}
@media (max-width:980px){.sf-nav{display:none}.sf-menu-mob{display:block}}
@media (max-width:760px){.sf-piede-in{grid-template-columns:1fr}}
</style>
