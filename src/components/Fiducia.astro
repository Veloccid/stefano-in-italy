---
// Blocco recensioni sobrio: stelle, citazione vera, screenshot originale e posti per le lettere scritte a mano.
import { RECENSIONI, CITAZIONE } from '../data/recensioni';
import Icona from './Icona.astro';
import T from './T.astro';
interface Props { lettere?: number; class?: string }
const { lettere = 3, class: cls } = Astro.props;
const vera = RECENSIONI[0];
---
<div class:list={['fid', cls]}>
  <div class="fid-testa">
    <div class="fid-stelle" aria-label="5/5">{[1, 2, 3, 4, 5].map(() => <Icona nome="stella" />)}</div>
    <T as="h2" k="fid.h" />
    <T as="p" k="fid.p" />
  </div>
  <div class="fid-griglia">
    <figure class="fid-cit">
      <blockquote>“{CITAZIONE.titolo} {CITAZIONE.testo}”</blockquote>
      <figcaption><T k="rev.quote.src" /></figcaption>
      <a class="fid-shot" href={vera.img} target="_blank" rel="noopener"><img src={vera.img} width={vera.w} height={vera.h} loading="lazy" alt={`Verified review on ${vera.fonte}`} /></a>
    </figure>
    <div class="fid-lettere">
      {Array.from({ length: lettere }, () => <div class="fid-lettera"><T k="fid.lettera" /></div>)}
    </div>
  </div>
  <T as="p" class="fid-nota" k="fid.tutte" />
</div>
<style is:global>
.fid{display:grid;gap:28px}
.fid-testa{display:grid;gap:10px;max-width:62ch}
.fid-stelle{display:flex;gap:4px;color:var(--ocra)}
.fid-stelle svg{width:28px;height:28px}
.fid-testa h2{font-size:clamp(32px,4.4vw,52px)}
.fid-testa p{margin:0;color:var(--muted);font-size:1.05em}
.fid-griglia{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:start}
.fid-cit{margin:0;background:#fff;border:1px solid rgba(0,59,31,.14);border-radius:18px;padding:24px;display:grid;grid-template-columns:1fr 150px;gap:8px 24px;align-items:start}
.fid-cit blockquote{margin:0;font:400 clamp(22px,2.4vw,28px)/1.3 var(--f-display);grid-column:1}
.fid-cit figcaption{grid-column:1;font-weight:700;color:var(--muted)}
.fid-shot{grid-column:2;grid-row:1 / span 2;display:block;border-radius:10px;overflow:hidden;border:1px solid rgba(0,59,31,.14)}
.fid-shot img{width:100%;height:auto}
.fid-lettere{display:grid;gap:12px}
.fid-lettera{min-height:96px;display:grid;place-items:center;text-align:center;padding:16px;border-radius:14px;background:#FBF3E4;border:1.5px dashed rgba(0,59,31,.25);color:var(--muted);font-size:16px}
.fid-nota{margin:0;color:var(--muted);font-size:15px}
@media (max-width:820px){.fid-griglia{grid-template-columns:1fr}.fid-cit{grid-template-columns:1fr}.fid-shot{grid-column:1;grid-row:auto;max-width:220px}}
</style>
