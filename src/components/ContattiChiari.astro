---
// Contatti leggibili: WhatsApp grande e l'email scritta per intero (molti viaggiatori over 60 preferiscono l'email).
import { SITO } from '../config';
import Icona from './Icona.astro';
import T from './T.astro';
interface Props { class?: string; cvHref?: string; hKey?: string; pKey?: string }
const { class: cls, cvHref, hKey = 'ct.h2', pKey = 'col.p' } = Astro.props;
---
<div class:list={['cc', cls]}>
  <T as="h2" k={hKey} />
  <T as="p" class="cc-p" k={pKey} />
  <div class="cc-righe">
    <a class="btn btn-wa cc-wa js-wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener"><Icona nome="wa" /><T k="wa.btn" /></a>
    <p class="cc-mail"><T k="ct.mail.l" /><br /><a href={`mailto:${SITO.email}`}>{SITO.email}</a></p>
  </div>
  <T as="p" class="cc-nota" k="ct.risposta" />
  <a class="cc-cv" href={cvHref ?? '#curriculum'} data-cv-open={cvHref ? undefined : ''}><Icona nome="cv" /><T k="cv.open" /></a>
</div>
<style is:global>
.cc{display:grid;gap:14px}
.cc h2{font-size:clamp(34px,4.6vw,54px)}
.cc-p{margin:0;max-width:56ch}
.cc-righe{display:flex;flex-wrap:wrap;align-items:center;gap:16px 32px;margin-top:6px}
.cc-wa{font-size:19px;min-height:60px;padding:14px 28px}
.cc-mail{margin:0;font-size:17px;line-height:1.4}
.cc-mail a{font-size:21px;font-weight:700;word-break:break-all}
.cc-nota{margin:0;font-size:16px;opacity:.85}
.cc-cv{display:inline-flex;align-items:center;gap:8px;font-weight:700;justify-self:start}
.cc-cv svg{width:22px;height:22px}
</style>
