---
// Proposta I: Il kit del tour leader. Una scrivania con gli oggetti del mestiere da cliccare.
import { RECENSIONI, CITAZIONE } from '../../data/recensioni';
import { SPECIALITA, SERVIZI, LINGUE_PARLATE, ZONE } from '../../data/curriculum';
import { SITO } from '../../config';
import Testata from '../../components/Testata.astro';
import Recensione from '../../components/Recensione.astro';
import BottoniContatto from '../../components/BottoniContatto.astro';
import Icona from '../../components/Icona.astro';
import T from '../../components/T.astro';
const oggetti = [
  { id: 'paletta', k: 'kit.paddle' },
  { id: 'radio', k: 'kit.radio' },
  { id: 'cartellina', k: 'kit.folder' },
  { id: 'taccuino', k: 'kit.notebook' },
  { id: 'telefono', k: 'kit.phone' },
];
---
<div class="p-kit">
  <Testata />
  <main id="contenuto">
    <section class="kit-testa wrap">
      <div>
        <T as="p" class="kit-kicker" k="tag.role" />
        <h1>Stefano In Italy</h1>
        <T as="p" class="kit-sub" k="intro.lead" />
      </div>
      <div class="kit-titolo">
        <T as="h2" k="kit.h" />
        <T as="p" class="hand" k="kit.hint" />
      </div>
    </section>

    <section class="kit-scrivania wrap" aria-labelledby="kitTitolo">
      <T as="h2" class="sr" k="kit.h" id="kitTitolo" />
      <div class="kit-tavolo">
        <img class="kit-stef" src="/img/stefano.webp" width="458" height="640" alt="" />
        <svg viewBox="0 0 1000 620" class="kit-svg">
          <defs>
            <pattern id="venature" width="1000" height="40" patternUnits="userSpaceOnUse"><path d="M0 20 C 250 10, 500 32, 1000 18" stroke="#E2D2B5" stroke-width="2" fill="none" /></pattern>
            <filter id="ombra" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#003B1F" flood-opacity=".22" /></filter>
          </defs>
          <rect width="1000" height="620" rx="26" fill="#EADBC0" />
          <rect width="1000" height="620" rx="26" fill="url(#venature)" />
          <!-- mappa piegata (decorazione) -->
          <g transform="rotate(-6 150 520)" opacity=".9" filter="url(#ombra)">
            <rect x="30" y="440" width="260" height="160" fill="#FEF6EB" />
            <path d="M117 440v160M203 440v160" stroke="#E2D2B5" stroke-width="2" />
            <path d="M60 560 C 100 500, 150 540, 190 480 S 250 470, 270 500" stroke="#B04A2A" stroke-width="3" stroke-dasharray="6 7" fill="none" />
            <circle cx="190" cy="480" r="7" fill="#003B1F" />
          </g>
          <!-- tazzina (decorazione) -->
          <g filter="url(#ombra)"><circle cx="905" cy="105" r="62" fill="#FEF6EB" /><circle cx="905" cy="105" r="44" fill="#6B3F22" /><circle cx="905" cy="105" r="30" fill="#8A5530" opacity=".7" /><rect x="960" y="92" width="34" height="24" rx="12" fill="#FEF6EB" /></g>
          <!-- occhiali da sole (decorazione) -->
          <g transform="rotate(12 760 520)"><rect x="690" y="500" width="62" height="38" rx="14" fill="#003B1F" /><rect x="768" y="500" width="62" height="38" rx="14" fill="#003B1F" /><path d="M752 512h16" stroke="#003B1F" stroke-width="6" /></g>

          <g class="kit-ogg" data-ogg="paletta" role="button" tabindex="0" aria-label="The paddle" data-i18n-aria="kit.paddle">
            <g filter="url(#ombra)" transform="rotate(-18 230 250)">
              <rect x="219" y="250" width="22" height="250" rx="11" fill="#C98E2B" />
              <circle cx="230" cy="190" r="96" fill="#FEF6EB" stroke="#B04A2A" stroke-width="16" />
              <text x="230" y="208" text-anchor="middle" font-family="DM Serif Display, serif" font-size="58" fill="#003B1F">SII!</text>
            </g>
          </g>
          <g class="kit-ogg" data-ogg="radio" role="button" tabindex="0" aria-label="The radio" data-i18n-aria="kit.radio">
            <g filter="url(#ombra)" transform="rotate(8 430 240)">
              <rect x="420" y="70" width="14" height="70" rx="7" fill="#1c2a22" />
              <rect x="380" y="130" width="110" height="210" rx="22" fill="#003B1F" />
              <rect x="400" y="152" width="70" height="40" rx="6" fill="#A9BFA3" />
              <text x="435" y="179" text-anchor="middle" font-family="DM Sans, sans-serif" font-weight="700" font-size="17" fill="#003B1F">EN·IT·ES</text>
              {[0, 1, 2, 3].map((r) => [0, 1, 2, 3].map((c) => <circle cx={407 + c * 19} cy={222 + r * 19} r="5" fill="#0F5233" />))}
              <circle cx="435" cy="318" r="9" fill="#C98E2B" />
            </g>
          </g>
          <g class="kit-ogg" data-ogg="cartellina" role="button" tabindex="0" aria-label="The folder" data-i18n-aria="kit.folder">
            <g filter="url(#ombra)" transform="rotate(-4 650 230)">
              <rect x="540" y="60" width="220" height="300" rx="14" fill="#B04A2A" />
              <rect x="560" y="92" width="180" height="250" rx="4" fill="#FEF6EB" />
              <rect x="605" y="48" width="90" height="34" rx="10" fill="#003B1F" />
              <text x="650" y="150" text-anchor="middle" font-family="DM Serif Display, serif" font-size="44" fill="#003B1F">CV</text>
              {[0, 1, 2, 3, 4, 5].map((i) => <rect x="582" y={180 + i * 24} width={i % 2 ? 110 : 136} height="8" rx="4" fill="#A9BFA3" />)}
            </g>
          </g>
          <g class="kit-ogg" data-ogg="taccuino" role="button" tabindex="0" aria-label="The notebook" data-i18n-aria="kit.notebook">
            <g filter="url(#ombra)" transform="rotate(5 470 470)">
              <rect x="350" y="390" width="250" height="170" rx="12" fill="#0F5233" />
              <rect x="560" y="390" width="12" height="170" fill="#C98E2B" />
              {[0, 1, 2, 3, 4].map((i) => <path transform={`translate(${378 + i * 36} 450) scale(1.35)`} d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" fill="#E3B458" />)}
              <text x="460" y="525" text-anchor="middle" font-family="Caveat, cursive" font-weight="600" font-size="30" fill="#FEF6EB">reviews</text>
            </g>
          </g>
          <g class="kit-ogg" data-ogg="telefono" role="button" tabindex="0" aria-label="The phone" data-i18n-aria="kit.phone">
            <g filter="url(#ombra)" transform="rotate(-10 860 380)">
              <rect x="800" y="250" width="124" height="240" rx="22" fill="#1c1c1a" />
              <rect x="810" y="268" width="104" height="204" rx="12" fill="#FEF6EB" />
              <rect x="822" y="290" width="70" height="30" rx="12" fill="#A9BFA3" />
              <rect x="842" y="330" width="62" height="26" rx="12" fill="#DDE6D5" />
              <circle cx="862" cy="420" r="28" fill="#1F7A4A" />
              <path transform="translate(845 403) scale(1.45)" fill="#fff" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z" />
            </g>
          </g>
        </svg>
      </div>
      <ul class="kit-lista">
        {oggetti.map((o) => <li><button type="button" class="kit-voce" data-ogg={o.id}><T k={o.k} /></button></li>)}
      </ul>
    </section>

    <section class="kit-chi wrap" id="contatti">
      <div>
        <T as="h2" k="intro.h" />
        <T as="p" k="intro.p1" />
        <T as="p" k="intro.p2" />
      </div>
      <div class="kit-chi-box">
        <T as="h3" k="col.h" />
        <T as="p" k="col.p" />
        <BottoniContatto />
      </div>
    </section>
  </main>
  <footer class="kit-piede wrap"><span>SII!</span><T as="p" k="foot" /></footer>

  <dialog class="kit-dlg" id="kitDlg" aria-labelledby="kitDlgT">
    <button type="button" class="kit-chiudi" aria-label="Close" data-i18n-aria="cv.close"><Icona nome="chiudi" /></button>
    <div class="kit-pan" data-pan="paletta">
      <T as="h2" k="kit.paddle" />
      <T as="p" k="col.p" />
      <ul class="kit-elenco">{SERVIZI.map((k) => <T as="li" k={k} />)}</ul>
      <ul class="chips">{SPECIALITA.map((k) => <T as="li" k={k} />)}</ul>
    </div>
    <div class="kit-pan" data-pan="radio">
      <T as="h2" k="kit.radio" />
      <T as="p" k="kit.radio.p" />
      <ul class="chips kit-lingue">{LINGUE_PARLATE.map((k) => <T as="li" k={k} />)}</ul>
      <T as="h3" k="f.where" />
      <ul class="chips">{ZONE.map((k) => <T as="li" k={k} />)}</ul>
    </div>
    <div class="kit-pan" data-pan="taccuino">
      <T as="h2" k="kit.notebook" />
      <p class="kit-cit">“{CITAZIONE.testo}”</p>
      <T as="p" class="kit-fonte" k="rev.quote.src" />
      <div class="kit-recs">{RECENSIONI.slice(0, 2).map((r, i) => <Recensione r={r} i={i} />)}</div>
    </div>
    <div class="kit-pan" data-pan="telefono">
      <T as="h2" k="kit.phone" />
      <T as="p" k="col.p" />
      <BottoniContatto cv={false} />
      <p class="kit-mail">{SITO.email} · <a href={SITO.instagram} target="_blank" rel="noopener">{SITO.instagramHandle}</a></p>
    </div>
  </dialog>
</div>

<style is:global>
.kit-testa{display:grid;grid-template-columns:1.1fr .9fr;gap:16px 48px;align-items:end;padding-top:clamp(24px,4vw,44px);padding-bottom:8px}
.kit-kicker{margin:0 0 10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;font-size:14px;color:var(--terracotta)}
.p-kit h1{font-size:clamp(48px,6vw,80px)}
.kit-sub{font:400 clamp(20px,2.2vw,26px)/1.35 var(--f-display);margin:16px 0 0;max-width:30ch}
.kit-titolo h2{font-size:clamp(28px,3.4vw,40px)}
.kit-titolo p{font-size:28px;color:var(--terracotta);margin:4px 0 0}
.kit-tavolo{position:relative;padding-top:clamp(40px,8vw,110px)}
.kit-stef{position:absolute;right:6%;top:0;width:clamp(90px,14vw,170px);height:auto;z-index:0}
.kit-svg{position:relative;z-index:1;width:100%;height:auto;display:block;border-radius:26px;box-shadow:0 30px 60px rgba(0,40,20,.18)}
.kit-ogg{cursor:pointer;transition:transform .25s cubic-bezier(.2,.8,.2,1);transform-box:fill-box;transform-origin:center}
.kit-ogg:hover,.kit-ogg:focus-visible{transform:translateY(-10px) scale(1.04)}
.kit-ogg:focus{outline:none}
.kit-ogg:focus-visible>g{filter:drop-shadow(0 0 6px #C98E2B)}
.kit-ogg.saluta{animation:saluta 1.2s ease-in-out 2}
@keyframes saluta{50%{transform:translateY(-8px) rotate(-2deg)}}
.kit-lista{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:24px 0 0;padding:0}
.kit-voce{appearance:none;border:2px solid var(--verde);background:transparent;color:var(--verde);font:600 15px/1.2 var(--f-sans);padding:10px 16px;border-radius:999px;cursor:pointer}
.kit-voce:hover{background:var(--verde);color:var(--crema)}
.kit-chi{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,5vw,64px);align-items:start;padding-top:clamp(64px,10vw,120px);padding-bottom:clamp(64px,10vw,120px)}
.kit-chi h2{font-size:clamp(34px,5vw,56px);margin-bottom:12px}
.kit-chi p{max-width:56ch}
.kit-chi-box{background:var(--verde);color:var(--crema);border-radius:24px;padding:clamp(24px,4vw,40px)}
.kit-chi-box h3{font-size:32px}
.kit-chi-box p{color:#DDE6D5}
.kit-chi-box .btn-linea{color:var(--crema)}
.kit-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:var(--muted);border-top:1px solid rgba(0,59,31,.15)}
.kit-piede span{font:400 32px/1 var(--f-display);color:var(--verde)}
.kit-piede p{margin:0}
.kit-dlg{border:0;border-radius:24px;padding:clamp(28px,5vw,48px);width:min(640px,calc(100% - 24px));max-height:calc(100dvh - 24px);background:var(--crema);color:var(--verde);box-shadow:0 30px 80px rgba(0,25,12,.4)}
.kit-dlg::backdrop{background:rgba(0,30,15,.55);backdrop-filter:blur(3px)}
.kit-dlg[open]{animation:cvdIn .3s cubic-bezier(.2,.8,.2,1)}
.kit-chiudi{position:sticky;top:0;float:right;margin:-12px -12px 0 0;width:44px;height:44px;border-radius:50%;border:2px solid var(--verde);background:var(--crema);color:var(--verde);display:grid;place-items:center;cursor:pointer;z-index:2}
.kit-chiudi svg{width:20px;height:20px}
.kit-pan h2{font-size:clamp(28px,4vw,40px);margin-bottom:14px;padding-right:40px}
.kit-pan h3{font-size:22px;margin:22px 0 10px}
.kit-pan>p{color:var(--muted)}
.kit-elenco{padding-left:20px;margin:0 0 18px}
.kit-lingue li{background:var(--verde);color:var(--crema);border-color:var(--verde)}
.kit-cit{font:italic 400 26px/1.25 var(--f-display);color:var(--verde)!important;margin:0 0 6px}
.kit-fonte{font-weight:600;margin:0 0 20px}
.kit-recs{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.kit-mail{margin-top:18px;font-size:15px}
@media (max-width:760px){
  .kit-testa,.kit-chi{grid-template-columns:1fr}
  .kit-tavolo{margin:0 calc(var(--pad) * -1 + 6px)}
  .kit-svg{border-radius:16px}
}
</style>
<script>
  const radice = document.querySelector('.p-kit');
  if (radice) {
    const dlg = document.getElementById('kitDlg') as HTMLDialogElement;
    const pannelli = [...dlg.querySelectorAll<HTMLElement>('.kit-pan')];
    const apri = (id: string) => {
      if (id === 'cartellina') { (document.querySelector('[data-cv-open]') as HTMLElement)?.click(); return; }
      pannelli.forEach((p) => (p.hidden = p.dataset.pan !== id));
      dlg.showModal(); dlg.scrollTop = 0;
    };
    radice.querySelectorAll<HTMLElement>('[data-ogg]').forEach((el) => {
      el.addEventListener('click', () => apri(el.dataset.ogg!));
      el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apri(el.dataset.ogg!); } });
    });
    dlg.querySelector('.kit-chiudi')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) { const r = dlg.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dlg.close(); } });
    // gli oggetti "salutano" uno alla volta per far capire che si cliccano
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ogg = [...radice.querySelectorAll<SVGGElement>('.kit-ogg')];
      let i = 0;
      const io = new IntersectionObserver((v) => { if (v[0].isIntersecting) { io.disconnect(); const giro = () => { ogg.forEach((o) => o.classList.remove('saluta')); ogg[i % ogg.length].classList.add('saluta'); i++; if (i < ogg.length * 2) setTimeout(giro, 1400); }; giro(); } }, { threshold: 0.4 });
      io.observe(radice.querySelector('.kit-svg')!);
    }
  }
</script>
