---
// Proposta N: Due porte. Agenzie e gruppi privati scelgono subito la propria strada.
import { SITO } from '../../config';
import Testata from '../../components/Testata.astro';
import Fiducia from '../../components/Fiducia.astro';
import ContattiChiari from '../../components/ContattiChiari.astro';
import Icona from '../../components/Icona.astro';
import T from '../../components/T.astro';
---
<div class="p-por">
  <Testata scura />
  <main id="contenuto">
    <section class="po-hero">
      <div class="wrap po-hero-in">
        <div class="po-chi">
          <img src="/img/stefano.webp" width="458" height="640" alt="Stefano, illustrated portrait" />
          <div>
            <h1>Stefano In Italy</h1>
            <T as="p" k="tag.role" class="po-ruolo" />
          </div>
        </div>
        <T as="h2" class="po-domanda" k="porte.h" />
        <div class="po-porte">
          <a class="po-porta" href="#agenzie">
            <span class="po-icona" aria-hidden="true">
              <svg viewBox="0 0 48 48"><rect x="8" y="14" width="32" height="26" rx="3" fill="none" stroke="currentColor" stroke-width="2.6" /><path d="M18 14v-4h12v4M8 24h32" fill="none" stroke="currentColor" stroke-width="2.6" /></svg>
            </span>
            <T as="strong" k="porte.ag" />
            <T as="span" k="porte.ag.d" />
            <span class="po-freccia">→</span>
          </a>
          <a class="po-porta" href="#privati">
            <span class="po-icona" aria-hidden="true">
              <svg viewBox="0 0 48 48"><circle cx="16" cy="17" r="6" fill="none" stroke="currentColor" stroke-width="2.6" /><circle cx="32" cy="17" r="6" fill="none" stroke="currentColor" stroke-width="2.6" /><path d="M5 40c1-8 6-12 11-12s10 4 11 12M21 40c1-8 6-12 11-12s10 4 11 12" fill="none" stroke="currentColor" stroke-width="2.6" /></svg>
            </span>
            <T as="strong" k="porte.pr" />
            <T as="span" k="porte.pr.d" />
            <span class="po-freccia">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="po-strada wrap" id="agenzie">
      <p class="po-etichetta"><T k="porte.ag" /></p>
      <T as="h2" k="ag.h" />
      <ul class="po-punti">{['ag.0', 'ag.1', 'ag.2', 'ag.3'].map((k) => <li><Icona nome="spunta" /><T k={k} /></li>)}</ul>
      <div class="po-azioni">
        <a class="btn btn-linea" href="#curriculum" data-cv-open><Icona nome="cv" /><T k="cv.open" /></a>
        <a class="btn btn-wa js-wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener"><Icona nome="wa" /><T k="wa.btn" /></a>
      </div>
    </section>

    <section class="po-strada po-privati" id="privati">
      <div class="wrap">
        <p class="po-etichetta"><T k="porte.pr" /></p>
        <T as="h2" k="pr.h" />
        <p class="po-provv" lang="it">Testo provvisorio</p>
        <ol class="po-passi">
          {['pr.0', 'pr.1', 'pr.2'].map((k, i) => <li><span class="po-n">{i + 1}</span><T k={k} /></li>)}
        </ol>
        <T as="p" class="po-best" k="pr.best" />
      </div>
    </section>

    <section class="po-sez wrap" id="recensioni"><Fiducia lettere={2} /></section>
    <section class="po-ct" id="contatti"><div class="wrap"><ContattiChiari /></div></section>
  </main>
  <footer class="po-piede wrap"><span>SII!</span><T as="p" k="foot" /></footer>
</div>
<style is:global>
.p-por{font-size:19px;line-height:1.6}
.po-hero{background:var(--verde);color:var(--crema);padding:clamp(32px,5vw,64px) 0 clamp(48px,7vw,88px)}
.po-hero-in{display:grid;gap:22px}
.po-chi{display:flex;align-items:center;gap:18px}
.po-chi img{width:84px;height:84px;object-fit:cover;object-position:top;border-radius:50%;background:#0F5233;padding:6px 6px 0}
.p-por h1{font-size:clamp(34px,4.6vw,56px)}
.po-ruolo{margin:2px 0 0;font-size:15px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#E3B458}
.po-domanda{font-size:clamp(30px,4vw,48px);margin-top:12px}
.po-porte{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.po-porta{display:grid;gap:8px;align-content:start;background:var(--crema);color:var(--verde);text-decoration:none;border-radius:22px;padding:26px 26px 22px;border:3px solid transparent;transition:border-color .2s,transform .2s;position:relative}
.po-porta:hover,.po-porta:focus-visible{border-color:#E3B458;transform:translateY(-3px)}
.po-icona{width:52px;height:52px;color:var(--terracotta)}
.po-porta strong{font:400 clamp(24px,2.6vw,32px)/1.15 var(--f-display)}
.po-porta span{color:var(--muted)}
.po-freccia{position:absolute;right:24px;bottom:18px;font-size:30px;color:var(--verde)!important}
.po-strada{padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px);scroll-margin-top:70px}
.po-etichetta{margin:0 0 6px;font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--terracotta)}
.po-strada h2{font-size:clamp(32px,4.4vw,52px)}
.po-punti{list-style:none;margin:22px 0 28px;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:16px 28px}
.po-punti li{display:flex;gap:12px;align-items:flex-start}
.po-punti svg{width:26px;height:26px;flex:none;margin-top:3px}
.po-azioni{display:flex;flex-wrap:wrap;gap:14px}
.po-azioni .btn{font-size:18px;min-height:58px}
.po-privati{background:var(--carta)}
.po-provv{display:inline-block;margin:10px 0 0;font-size:13px;font-weight:700;background:rgba(201,142,43,.25);padding:3px 8px;border-radius:4px}
.po-passi{list-style:none;margin:22px 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.po-passi li{background:#fff;border-radius:18px;padding:22px;display:grid;gap:10px;align-content:start}
.po-passi .po-n{width:44px;height:44px;border-radius:50%;background:var(--verde);color:var(--crema);display:grid;place-items:center;font:400 22px/1 var(--f-display)}
.po-best{font:400 clamp(21px,2.3vw,26px)/1.35 var(--f-display);margin:0}
.po-sez{padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px)}
.po-ct{background:var(--verde);color:var(--crema);padding:clamp(56px,8vw,96px) 0}
.po-ct .cc-mail a{color:var(--crema)}
.po-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:var(--muted);font-size:16px}
.po-piede span{font:400 32px/1 var(--f-display);color:var(--verde)}
.po-piede p{margin:0}
@media (max-width:760px){.po-porte,.po-punti,.po-passi{grid-template-columns:1fr}}
</style>
