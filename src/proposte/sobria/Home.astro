---
// Proposta K: SII! sobria. La A resa calma: un solo movimento, testi grandi, recensioni subito, email visibile.
import { SITO } from '../../config';
import Lingue from '../../components/Lingue.astro';
import Fiducia from '../../components/Fiducia.astro';
import ContattiChiari from '../../components/ContattiChiari.astro';
import Icona from '../../components/Icona.astro';
import T from '../../components/T.astro';
---
<div class="p-sob">
  <header class="sb-barra">
    <a href="#contenuto" class="sb-logo" aria-label="Stefano In Italy">SII!</a>
    <nav aria-label="Sections" data-i18n-aria="nav.aria">
      <a href="#recensioni"><T k="nav.reviews" /></a>
      <a href="#contatti"><T k="nav.collab" /></a>
    </nav>
    <Lingue class="su-verde" />
  </header>
  <main id="contenuto">
    <section class="sb-hero">
      <img class="sb-stef" src="/img/stefano.webp" width="458" height="640" alt="Stefano, illustrated portrait" />
      <h1 class="sb-brand" aria-label="Stefano In Italy"><span class="k">S</span><span class="c">tefano</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">n</span><span class="c">&nbsp;</span><span class="k">I</span><span class="c">taly</span><span class="bang">!</span></h1>
      <T as="p" class="sb-ruolo" k="tag.role" />
      <T as="p" class="sb-sub" k="hero.sub" />
      <div class="sb-azioni">
        <a class="btn btn-wa js-wa" href={`https://wa.me/${SITO.whatsapp}`} target="_blank" rel="noopener"><Icona nome="wa" /><T k="wa.btn" /></a>
        <a class="btn sb-mail" href={`mailto:${SITO.email}`}><Icona nome="mail" /><T k="ct.email" /></a>
      </div>
    </section>

    <section class="sb-sez wrap" id="recensioni"><Fiducia /></section>

    <section class="sb-chi">
      <div class="wrap sb-chi-in">
        <div class="foto-vuota sb-foto"><T k="ph.photo" /></div>
        <div>
          <T as="h2" k="intro.h" />
          <T as="p" class="sb-lead" k="intro.lead" />
          <T as="p" k="intro.p1" />
          <T as="p" k="intro.p2" />
        </div>
      </div>
    </section>

    <section class="sb-sez wrap" id="contatti"><ContattiChiari /></section>
  </main>
  <footer class="sb-piede wrap"><span>SII!</span><T as="p" k="foot" /><a href={SITO.instagram} target="_blank" rel="noopener">{SITO.instagramHandle}</a></footer>
</div>
<style is:global>
@property --q { syntax: '<number>'; inherits: true; initial-value: 0; }
.p-sob{font-size:19px;line-height:1.6}
.sb-barra{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:20px;padding:12px var(--pad);background:var(--verde);color:var(--crema)}
.sb-logo{font:400 30px/1 var(--f-display);text-decoration:none;margin-right:auto}
.sb-barra nav{display:flex;gap:22px}
.sb-barra nav a{text-decoration:none;font-weight:600;font-size:17px}
.sb-barra nav a:hover{text-decoration:underline;text-underline-offset:4px}
.sb-hero{background:var(--verde);color:var(--crema);display:grid;justify-items:center;text-align:center;gap:14px;padding:clamp(32px,6vw,72px) var(--pad) clamp(48px,7vw,88px)}
.sb-stef{width:clamp(120px,15vw,180px);height:auto;-webkit-mask-image:linear-gradient(#000 78%,transparent);mask-image:linear-gradient(#000 78%,transparent)}
.sb-brand{margin:0;font-size:clamp(46px,8vw,104px);white-space:nowrap;display:inline-flex;align-items:baseline;animation:sbUnaVolta 1.4s 1.2s cubic-bezier(.6,0,.3,1) forwards}
.sb-brand .c{display:inline-block;overflow:hidden;vertical-align:baseline;padding-bottom:.22em;margin-bottom:-.22em;max-width:calc(var(--w,4em) * (1 - var(--q)));opacity:calc(1 - var(--q) * 2.5)}
.sb-brand .bang{display:inline-block;overflow:hidden;max-width:calc(.36em * var(--q));opacity:var(--q)}
@keyframes sbUnaVolta{to{--q:1}}
.sb-ruolo{margin:0;font-size:15px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#E3B458}
.sb-sub{margin:0;max-width:40ch;font-size:clamp(19px,2vw,22px);color:#E7EEE3}
.sb-azioni{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:8px}
.sb-azioni .btn{font-size:18px;min-height:58px}
.sb-mail{border:2px solid var(--crema);color:var(--crema)}
.sb-mail:hover{background:var(--crema);color:var(--verde)}
.sb-sez{padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px)}
.sb-chi{background:var(--carta);padding:clamp(56px,8vw,96px) 0}
.sb-chi-in{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(28px,5vw,64px);align-items:center}
.sb-chi h2{font-size:clamp(34px,4.6vw,54px);margin-bottom:12px}
.sb-chi p{max-width:58ch}
.sb-lead{font:400 clamp(22px,2.4vw,27px)/1.35 var(--f-display)}
.sb-foto{aspect-ratio:4/5;border-radius:18px}
.sb-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:var(--muted);border-top:1px solid rgba(0,59,31,.15);font-size:16px}
.sb-piede span{font:400 32px/1 var(--f-display);color:var(--verde)}
.sb-piede p{margin:0;flex:1;min-width:220px}
@media (max-width:760px){.sb-chi-in{grid-template-columns:1fr}.sb-foto{max-width:320px}.sb-barra nav a:first-child{display:none}}
@media (prefers-reduced-motion:reduce){.sb-brand{animation:none}}
</style>
<script>
  const b = document.querySelector<HTMLElement>('.p-sob .sb-brand');
  if (b) {
    const misura = () => { const fs = parseFloat(getComputedStyle(b).fontSize); b.querySelectorAll<HTMLElement>('.c').forEach((el) => { el.style.maxWidth = 'none'; const w = el.scrollWidth / fs; el.style.maxWidth = ''; el.style.setProperty('--w', w + 0.02 + 'em'); }); };
    misura(); document.fonts?.ready.then(misura); addEventListener('resize', misura);
  }
</script>
