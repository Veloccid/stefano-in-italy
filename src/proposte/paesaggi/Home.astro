---
// Proposta I: Paesaggi. Un panorama a strati (Toscana, Lazio, Puglia, mare) che scorre in parallasse:
// Stefano ci cammina dentro e si toccano gli oggetti del paesaggio.
import { TAPPE, SERVIZI } from '../../data/curriculum';
import { RECENSIONI, CITAZIONE } from '../../data/recensioni';
import { ZONE_MAPPA, NOMI } from '../../data/zone';
import Testata from '../../components/Testata.astro';
import Recensione from '../../components/Recensione.astro';
import BottoniContatto from '../../components/BottoniContatto.astro';
import Icona from '../../components/Icona.astro';
import T from '../../components/T.astro';
const tappa = (n: number) => TAPPE.find((t) => t.n === n)!;
const zona = (id: string) => ZONE_MAPPA.find((z) => z.id === id)!;

// ---------- disegni (unità SVG: 5200 x 700) ----------
const V = '#003B1F', V2 = '#0F5233', S = '#A9BFA3', C = '#FEF6EB', K = '#F2E6D2', TE = '#B04A2A', O = '#C98E2B';
const onda = (y: number, amp: number, passo: number, w = 5200, seme = 1) => {
  let d = `M0 700 L0 ${y}`;
  for (let x = 0; x <= w; x += passo) d += ` Q${x + passo / 2} ${y - amp * (0.6 + 0.4 * Math.sin((x + seme * 97) / 310))} ${x + passo} ${y}`;
  return d + ` L${w} 700 Z`;
};
const cipresso = (x: number, y: number, h = 120, f = V) => `<path d="M${x} ${y - h} C${x + h * 0.16} ${y - h * 0.7} ${x + h * 0.15} ${y - h * 0.15} ${x} ${y} C${x - h * 0.15} ${y - h * 0.15} ${x - h * 0.16} ${y - h * 0.7} ${x} ${y - h}Z" fill="${f}"/>`;
const ulivo = (x: number, y: number, r = 34, f = V2) => `<path d="M${x - 3} ${y} q-4 -22 4 -40 l6 0 q-2 20 4 40z" fill="#5b4a33"/><ellipse cx="${x - r * 0.4}" cy="${y - 44}" rx="${r * 0.75}" ry="${r * 0.5}" fill="${f}"/><ellipse cx="${x + r * 0.45}" cy="${y - 50}" rx="${r * 0.7}" ry="${r * 0.5}" fill="${f}"/><ellipse cx="${x}" cy="${y - 64}" rx="${r * 0.6}" ry="${r * 0.42}" fill="${f}" opacity=".9"/>`;
const trullo = (x: number, y: number, s = 1) => `<g transform="translate(${x} ${y}) scale(${s})"><rect x="-34" y="-58" width="68" height="58" fill="${C}"/><path d="M-38 -58 L0 -128 L38 -58Z" fill="#6f7d70"/><path d="M-30 -72 L30 -72 M-24 -86 L24 -86 M-17 -100 L17 -100 M-10 -114 L10 -114" stroke="#5d6a5e" stroke-width="2"/><circle cx="0" cy="-134" r="6" fill="${C}"/><rect x="-10" y="-34" width="20" height="34" rx="10" fill="${V}"/></g>`;
const casa = (x: number, y: number, w: number, h: number, f = C) => `<rect x="${x}" y="${y - h}" width="${w}" height="${h}" fill="${f}"/><rect x="${x + w * 0.3}" y="${y - h * 0.65}" width="${w * 0.18}" height="${h * 0.22}" fill="${V2}" opacity=".7"/>`;

const lontano = `<path d="${onda(430, 120, 520, 5200, 3)}" fill="#D7DECF"/><path d="${onda(470, 70, 300, 5200, 7)}" fill="#C9D3C1"/>`;
let medio = `<path d="${onda(520, 70, 260, 1500, 2)}" fill="${S}"/>`;
for (const x of [120, 160, 420, 455, 490, 900, 1180, 1215]) medio += cipresso(x, 470 + (x % 60), 70, V2);
medio += `<path d="M1400 700 L1400 500 L1560 330 L1700 440 L1820 360 L2000 500 L2000 700Z" fill="#B7C6B0"/><path d="M1560 330 L1600 372 L1520 372Z" fill="${C}"/>`;
medio += `<rect x="1980" y="520" width="1100" height="180" fill="${S}"/>`;
for (let x = 2020; x < 3000; x += 90) medio += ulivo(x, 540 + (x % 3) * 6, 22, '#8FA88A');
medio += `<rect x="3080" y="540" width="2200" height="160" fill="#B9CDBA"/>`;
for (let x = 3150; x < 5200; x += 160) medio += `<path d="M${x} 580 q20 -8 40 0" stroke="${C}" stroke-width="3" fill="none" opacity=".7"/>`;

let vicino = `<rect x="0" y="575" width="4320" height="125" fill="${V}"/><rect x="0" y="596" width="4320" height="20" fill="#E9DCC0"/>`;
vicino += `<rect x="4320" y="560" width="900" height="140" fill="#9DB7A6"/>`;
for (let x = 4360; x < 5200; x += 110) vicino += `<path d="M${x} ${640 + (x % 3) * 12} q22 -10 44 0" stroke="${C}" stroke-width="4" fill="none" opacity=".8"/>`;
vicino += `<rect x="4320" y="600" width="760" height="12" fill="#8a6a45"/>` + [4380, 4520, 4660, 4800, 4940, 5060].map((x) => `<rect x="${x}" y="606" width="10" height="60" fill="#6d5236"/>`).join('');
// Toscana: cipressi e casale
for (const x of [80, 150, 260, 940, 1010, 1080, 1290]) vicino += cipresso(x, 590, 110 + (x % 40));
vicino += `<rect x="740" y="510" width="150" height="80" fill="${K}"/><path d="M728 512 L815 470 L902 512Z" fill="${TE}"/><rect x="790" y="545" width="26" height="45" fill="${V2}"/>`;
// Lazio: borgo sulla collina
vicino += `<path d="M1700 590 C1760 470 1980 440 2100 590Z" fill="${V2}"/>` + casa(1790, 520, 60, 50) + casa(1855, 505, 70, 64, K) + casa(1930, 515, 55, 48) + `<rect x="1880" y="420" width="34" height="100" fill="${K}"/><path d="M1874 420 L1897 398 L1920 420Z" fill="${TE}"/>`;
// Puglia: ulivi, muretti a secco, trulli
for (let x = 2560; x < 4100; x += 150) { if (x > 3060 && x < 3460) continue; vicino += ulivo(x, 588, 30 + (x % 20)); }
for (let x = 2520; x < 4150; x += 26) vicino += `<rect x="${x}" y="${578 + (x % 4)}" width="22" height="12" rx="3" fill="#d8ccb3"/>`;
vicino += trullo(3150, 590, 1) + trullo(3245, 590, 1.25) + trullo(3350, 590, 0.95);
// costa bianca
vicino += casa(4120, 575, 70, 70) + casa(4190, 575, 60, 92, K) + casa(4250, 575, 70, 60);
---
<div class="p-pae">
  <Testata />
  <main id="contenuto">
    <section class="pa-giro">
      <div class="pa-vista">
        <div class="pa-sole" aria-hidden="true"></div>
        <div class="pa-strato pa-lontano" data-v=".22" aria-hidden="true"><svg viewBox="0 0 5200 700" preserveAspectRatio="xMinYMax meet" set:html={lontano} /></div>
        <div class="pa-strato pa-medio" data-v=".5" aria-hidden="true"><svg viewBox="0 0 5200 700" preserveAspectRatio="xMinYMax meet" set:html={medio} /></div>
        <div class="pa-strato pa-vicino" data-v="1">
          <svg viewBox="0 0 5200 700" preserveAspectRatio="xMinYMax meet">
            <g set:html={vicino} />
            <g class="pa-bus" transform="translate(2300 596)">
              <rect x="0" y="-62" width="150" height="62" rx="12" fill="#C98E2B" /><rect x="10" y="-52" width="130" height="22" rx="4" fill="#FEF6EB" />
              <rect x="4" y="-24" width="142" height="6" fill="#B04A2A" /><circle cx="32" cy="0" r="13" fill="#1c1c1a" /><circle cx="118" cy="0" r="13" fill="#1c1c1a" />
              <text x="75" y="-36" text-anchor="middle" font-family="DM Serif Display, serif" font-size="16" fill="#003B1F">SII!</text>
            </g>
            <g transform="translate(4840 560)"><path d="M-60 40 Q0 -10 60 40Z" fill="#7d8b7f" /><rect x="-16" y="-150" width="32" height="160" fill="#FEF6EB" /><rect x="-16" y="-110" width="32" height="22" fill="#B04A2A" /><rect x="-16" y="-60" width="32" height="22" fill="#B04A2A" /><rect x="-22" y="-176" width="44" height="28" fill="#003B1F" /><path d="M-26 -176 L0 -196 L26 -176Z" fill="#B04A2A" /><path class="pa-luce" d="M22 -164 L260 -210 L260 -120Z" fill="#E3B458" opacity=".35" /></g>
            {[
              { id: 'toscana', x: 1010, y: 440 },
              { id: 'casale', x: 815, y: 455 },
              { id: 'lazio', x: 1897, y: 380 },
              { id: 'bus', x: 2375, y: 640 },
              { id: 'puglia', x: 3245, y: 410 },
              { id: 'faro', x: 4840, y: 330 },
            ].map((h) => (
              <g class="pa-hot" data-hot={h.id === 'casale' ? 'toscana' : h.id} transform={`translate(${h.x} ${h.y})`} role="button" tabindex="0" aria-label={h.id}>
                <circle class="pa-hot-onda" r="22" /><circle class="pa-hot-c" r="16" /><path d="M-7 0h14M0 -7v14" stroke="#003B1F" stroke-width="3.4" stroke-linecap="round" />
              </g>
            ))}
          </svg>
        </div>
        <div class="pa-stef" aria-hidden="true"><img src="/img/stefano.webp" width="458" height="640" alt="" /></div>

        <div class="pa-titolo">
          <T as="p" class="pa-kicker" k="tag.role" />
          <h1>Stefano In Italy</h1>
          <T as="h2" k="pae.h" />
          <T as="p" class="pa-hint hand" k="pae.hint" />
        </div>
        <p class="pa-regione" aria-live="polite">
          <T k="z.toscana" data-r="0" class="on" /><T k="z.lazio" data-r="1" /><T k="z.puglia" data-r="2" /><span data-r="3">SII!</span>
        </p>
        <div class="pa-barra" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <section class="pa-rec" id="recensioni">
      <div class="wrap pa-rec-in">
        <div>
          <T as="h2" k="rev.h" />
          <p class="pa-cit">“{CITAZIONE.testo}”</p>
          <T as="p" class="pa-fonte" k="rev.quote.src" />
          <BottoniContatto />
        </div>
        <div class="pa-recs">{RECENSIONI.slice(0, 2).map((r, i) => <Recensione r={r} i={i} />)}</div>
      </div>
    </section>
  </main>
  <footer class="pa-piede wrap"><span>SII!</span><T as="p" k="foot" /></footer>

  <dialog class="pa-dlg" id="paDlg">
    <button type="button" class="pa-chiudi" aria-label="Close" data-i18n-aria="cv.close"><Icona nome="chiudi" /></button>
    {['toscana', 'lazio', 'puglia'].map((id) => (
      <div class="pa-pan" data-pan={id}>
        <h2><T k={zona(id).k} />{zona(id).recente && <T class="pa-badge" k="z.recente" />}</h2>
        <T as="p" k={zona(id).d} />
        <p class="pa-nomi">{zona(id).punti.map((p) => NOMI[p]).join(' · ')}</p>
        <ul>{zona(id).tappe.map((n) => <li><span>{tappa(n).anni}</span> <T k={`cv.${n}.h`} /></li>)}</ul>
      </div>
    ))}
    <div class="pa-pan" data-pan="bus">
      <T as="h2" k="pae.bus" />
      <T as="p" k="pae.bus.d" />
      <ul class="chips">{SERVIZI.map((k) => <T as="li" k={k} />)}</ul>
    </div>
    <div class="pa-pan" data-pan="faro">
      <T as="h2" k="pae.faro" />
      <T as="p" k="col.p" />
      <BottoniContatto />
    </div>
  </dialog>
</div>

<style is:global>
.p-pae{overflow-x:clip}
.pa-giro{height:520vh}
.pa-vista{position:sticky;top:0;height:100dvh;overflow:hidden;background:linear-gradient(color-mix(in srgb,#FEF6EB calc(100% - var(--p,0) * 55%),#F2C98A),color-mix(in srgb,#F2E6D2 calc(100% - var(--p,0) * 40%),#E9B77A))}
.pa-sole{position:absolute;width:clamp(90px,12vw,150px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#F6D58E,#E3B458 60%,rgba(227,180,88,0) 72%);left:calc(12% + var(--p,0) * 70%);top:calc(14% + var(--p,0) * var(--p,0) * 30%)}
.pa-strato{position:absolute;left:0;bottom:0;height:min(100%,92vh);aspect-ratio:5200/700;transform:translate3d(var(--tx,0),0,0);will-change:transform}
.pa-strato svg{width:100%;height:100%;display:block}
.pa-lontano{height:min(100%,80vh)}
.pa-hot{cursor:pointer}
.pa-hot:focus{outline:none}
.pa-hot-c{fill:#FEF6EB;stroke:#E3B458;stroke-width:4;transition:transform .2s;transform-box:fill-box;transform-origin:center}
.pa-hot:hover .pa-hot-c,.pa-hot:focus-visible .pa-hot-c{transform:scale(1.25)}
.pa-hot-onda{fill:none;stroke:#FEF6EB;stroke-width:3;transform-box:fill-box;transform-origin:center;animation:paOnda 2s infinite}
@keyframes paOnda{0%{opacity:.9;transform:scale(.7)}100%{opacity:0;transform:scale(2.2)}}
.pa-luce{animation:paLuce 3s ease-in-out infinite;transform-origin:22px -164px;transform-box:view-box}
@keyframes paLuce{50%{opacity:.08}}
.pa-stef{position:absolute;left:28%;bottom:calc(min(100dvh,92vh) * 96 / 700);width:clamp(70px,9vh,110px);transform:translateX(-50%);z-index:3;pointer-events:none}
.pa-stef img{width:100%;height:auto;display:block;transform:scaleX(var(--verso,-1)) translateY(var(--salto,0px)) rotate(var(--dondola,0deg));transform-origin:50% 100%;-webkit-mask-image:linear-gradient(#000 78%,transparent);mask-image:linear-gradient(#000 78%,transparent)}
.pa-titolo{position:absolute;left:var(--pad);top:clamp(16px,4vh,40px);z-index:4;opacity:calc(1 - var(--p,0) * 10);max-width:560px}
.pa-kicker{margin:0 0 6px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;font-size:13px;color:var(--terracotta)}
.p-pae h1{font-size:clamp(42px,6vw,84px)}
.pa-titolo h2{font-size:clamp(22px,2.6vw,32px);margin-top:8px}
.pa-hint{font-size:26px;color:var(--terracotta);margin:6px 0 0}
.pa-regione{position:absolute;left:0;right:0;top:clamp(70px,14vh,130px);margin:0;display:grid;justify-items:center;z-index:3;pointer-events:none;opacity:clamp(0,calc(var(--p,0) * 12 - .6),1)}
.pa-regione>*{grid-area:1/1;font:400 clamp(44px,8vw,110px)/1 var(--f-display);color:var(--verde);opacity:0;transform:translateY(20px);transition:opacity .6s,transform .6s}
.pa-regione>.on{opacity:.9;transform:none}
.pa-barra{position:absolute;left:var(--pad);right:var(--pad);bottom:calc(14px + env(safe-area-inset-bottom,0px));height:3px;background:rgba(254,246,235,.35);border-radius:3px;z-index:4;display:none}
.pa-barra span{display:block;height:100%;width:calc(var(--p,0) * 100%);background:#E3B458;border-radius:3px}
.pa-rec{background:var(--verde);color:var(--crema);padding:clamp(56px,8vw,96px) 0}
.pa-rec-in{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:center}
.pa-rec h2{font-size:clamp(34px,5vw,56px)}
.pa-cit{font:italic 400 clamp(24px,3vw,36px)/1.2 var(--f-display);margin:18px 0 8px}
.pa-fonte{color:#C9D6C6;font-weight:600;margin-bottom:24px}
.pa-rec .btn-linea{color:var(--crema)}
.pa-recs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.pa-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:var(--muted)}
.pa-piede span{font:400 32px/1 var(--f-display);color:var(--verde)}
.pa-piede p{margin:0}
.pa-dlg{border:0;border-radius:24px;padding:clamp(26px,5vw,44px);width:min(560px,calc(100% - 24px));max-height:calc(100dvh - 24px);background:var(--crema);color:var(--verde);box-shadow:0 30px 80px rgba(0,25,12,.4)}
.pa-dlg::backdrop{background:rgba(0,30,15,.45);backdrop-filter:blur(3px)}
.pa-dlg[open]{animation:cvdIn .3s cubic-bezier(.2,.8,.2,1)}
.pa-chiudi{float:right;margin:-10px -10px 0 0;width:44px;height:44px;border-radius:50%;border:2px solid var(--verde);background:var(--crema);color:var(--verde);display:grid;place-items:center;cursor:pointer}
.pa-chiudi svg{width:20px;height:20px}
.pa-pan h2{font-size:clamp(28px,4vw,40px);display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding-right:44px}
.pa-pan>p{color:var(--muted)}
.pa-badge{font:700 11px/1 var(--f-sans);letter-spacing:.1em;text-transform:uppercase;background:var(--terracotta);color:var(--crema);padding:6px 9px;border-radius:999px}
.pa-nomi{font-weight:700;color:var(--terracotta)!important}
.pa-pan ul:not(.chips){list-style:none;margin:0;padding:0;display:grid;gap:6px}
.pa-pan ul span{font:600 19px/1 var(--f-hand);color:var(--terracotta)}
@media (max-width:760px){
  .pa-rec-in{grid-template-columns:1fr}
  .pa-stef{left:34%}
}
@media (prefers-reduced-motion:reduce){.pa-hot-onda,.pa-luce{animation:none}}
</style>

<script>
  const giro = document.querySelector<HTMLElement>('.p-pae .pa-giro');
  if (giro) {
    const strati = [...giro.querySelectorAll<HTMLElement>('.pa-strato')];
    const stef = giro.querySelector<HTMLElement>('.pa-stef img')!;
    const regioni = [...giro.querySelectorAll<HTMLElement>('.pa-regione [data-r]')];
    const dlg = document.getElementById('paDlg') as HTMLDialogElement;
    const pannelli = [...dlg.querySelectorAll<HTMLElement>('.pa-pan')];
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pS = 0, prec = 0, fase = 0, passo = 0, reg = 0;
    function tick() {
      const r = giro!.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
      pS = ridotto ? p : pS + (p - pS) * 0.1;
      const vicino = strati[strati.length - 1];
      const maxShift = vicino.offsetWidth - innerWidth;
      strati.forEach((s) => s.style.setProperty('--tx', `${(-pS * maxShift * Number(s.dataset.v)).toFixed(1)}px`));
      giro!.style.setProperty('--p', pS.toFixed(4));
      // Stefano cammina: dondola e saltella solo quando si muove
      const v = (pS - prec) * 1000; prec = pS;
      passo += (Math.min(1, Math.abs(v) * 2) - passo) * 0.15;
      fase += Math.abs(v) * 0.9 + passo * 0.12;
      if (!ridotto) {
        stef.style.setProperty('--salto', `${(-Math.abs(Math.sin(fase)) * 7 * passo).toFixed(2)}px`);
        stef.style.setProperty('--dondola', `${(Math.sin(fase) * 3 * passo).toFixed(2)}deg`);
      }
      if (v > 0.02) stef.style.setProperty('--verso', '-1'); else if (v < -0.02) stef.style.setProperty('--verso', '1');
      // regione sotto i piedi di Stefano (in unità del disegno)
      const x = ((innerWidth * (innerWidth <= 760 ? 0.34 : 0.28) + pS * maxShift) / vicino.offsetWidth) * 5200;
      const nr = x < 1450 ? 0 : x < 2480 ? 1 : x < 4300 ? 2 : 3;
      if (nr !== reg) { reg = nr; regioni.forEach((e) => e.classList.toggle('on', Number(e.dataset.r) === reg)); }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
    const apri = (id: string) => { pannelli.forEach((p) => (p.hidden = p.dataset.pan !== id)); dlg.showModal(); dlg.scrollTop = 0; };
    giro.querySelectorAll<SVGGElement>('.pa-hot').forEach((h) => {
      h.addEventListener('click', () => apri(h.dataset.hot!));
      h.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apri(h.dataset.hot!); } });
    });
    dlg.querySelector('.pa-chiudi')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
