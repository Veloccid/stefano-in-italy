---
// Proposta L: La mappa tranquilla. Mappa illustrata ferma ed elegante; si tocca una regione e si legge cosa ha fatto lì.
import { TAPPE } from '../../data/curriculum';
import { ITALIA_PATH, ITALIA_W, ITALIA_H } from '../../data/italia';
import { ZONE_MAPPA, NOMI, NOMI_KEY, xy } from '../../data/zone';
import Testata from '../../components/Testata.astro';
import Fiducia from '../../components/Fiducia.astro';
import ContattiChiari from '../../components/ContattiChiari.astro';
import T from '../../components/T.astro';
const tappa = (n: number) => TAPPE.find((t) => t.n === n)!;
const ordine = ['puglia', 'lazio', 'toscana', 'emilia'];
const zone = ordine.map((id) => ZONE_MAPPA.find((z) => z.id === id)!);
const centro = (ids: string[]) => { const p = ids.map(xy); return [p.reduce((a, b) => a + b[0], 0) / p.length, p.reduce((a, b) => a + b[1], 0) / p.length]; };
---
<div class="p-mc">
  <Testata />
  <main id="contenuto">
    <section class="mc-hero wrap">
      <div class="mc-testo">
        <T as="p" class="mc-kicker" k="tag.role" />
        <h1>Stefano In Italy</h1>
        <T as="p" class="mc-sub" k="hero.sub" />
        <T as="h2" k="mc.h" />
        <T as="p" class="mc-p" k="mc.p" />
        <div class="mc-zone">
          {zone.map((z, i) => (
            <button type="button" class="mc-zona" data-zona={z.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="mc-num">{i + 1}</span><T k={z.k} />{z.recente && <T class="mc-badge" k="z.recente" />}
            </button>
          ))}
        </div>
      </div>
      <figure class="mc-carta">
        <svg viewBox={`-20 -20 ${ITALIA_W + 40} ${ITALIA_H + 40}`} role="img" aria-label="Map of Italy">
          <path d={ITALIA_PATH} class="mc-terra" />
          {zone.map((z, i) => {
            const [cx, cy] = centro(z.punti);
            return (
              <g class="mc-reg" data-zona={z.id}>
                {z.punti.map((p) => { const [x, y] = xy(p); return <circle cx={x} cy={y} r="4.5" class="mc-pt" />; })}
                <g transform={`translate(${cx} ${cy})`} class="mc-tag">
                  <circle r="17" /><text y="6" text-anchor="middle">{i + 1}</text>
                </g>
              </g>
            );
          })}
        </svg>
        <div class="mc-scheda" aria-live="polite">
          {zone.map((z, i) => (
            <div class="mc-info" data-info={z.id} hidden={i !== 0}>
              <h3><T k={z.k} /></h3>
              <T as="p" k={z.d} />
              <p class="mc-posti">{z.punti.map((p) => (NOMI_KEY[p] ? 'Firenze' : NOMI[p])).join(' · ')}</p>
              <ul>{z.tappe.slice(0, 3).map((n) => <li><span>{tappa(n).anni}</span> <T k={`cv.${n}.h`} /></li>)}</ul>
            </div>
          ))}
        </div>
      </figure>
    </section>
    <section class="mc-sez mc-fid" id="recensioni"><div class="wrap"><Fiducia /></div></section>
    <section class="mc-sez wrap" id="contatti"><ContattiChiari /></section>
  </main>
  <footer class="mc-piede wrap"><span>SII!</span><T as="p" k="foot" /></footer>
</div>
<style is:global>
.p-mc{font-size:19px;line-height:1.6}
.mc-hero{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,64px);align-items:start;padding-top:clamp(32px,5vw,64px);padding-bottom:clamp(48px,7vw,88px)}
.mc-kicker{margin:0 0 8px;font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--terracotta)}
.p-mc h1{font-size:clamp(44px,6vw,80px)}
.mc-sub{font-size:clamp(19px,2vw,22px);color:var(--muted);max-width:38ch;margin:14px 0 32px}
.mc-testo h2{font-size:clamp(28px,3.4vw,40px);padding-top:24px;border-top:2px solid var(--verde)}
.mc-p{color:var(--muted);margin:8px 0 18px}
.mc-zone{display:grid;gap:10px}
.mc-zona{appearance:none;display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:#fff;border:2px solid rgba(0,59,31,.14);border-radius:14px;padding:14px 16px;font:600 20px/1.2 var(--f-sans);color:var(--verde);cursor:pointer}
.mc-zona:hover{border-color:var(--verde)}
.mc-zona[aria-pressed="true"]{background:var(--verde);color:var(--crema);border-color:var(--verde)}
.mc-num{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--carta);color:var(--verde);font:400 19px/1 var(--f-display);flex:none}
.mc-zona[aria-pressed="true"] .mc-num{background:#E3B458}
.mc-badge{margin-left:auto;font:700 11px/1 var(--f-sans);letter-spacing:.1em;text-transform:uppercase;background:var(--terracotta);color:var(--crema);padding:6px 9px;border-radius:999px}
.mc-carta{margin:0;position:sticky;top:90px;display:grid;gap:16px}
.mc-carta svg{width:100%;height:auto;max-height:68vh;background:#FBF3E4;border-radius:22px;border:1px solid rgba(0,59,31,.12)}
.mc-terra{fill:#DCE5D6;stroke:var(--verde);stroke-width:1.6;stroke-linejoin:round}
.mc-pt{fill:var(--verde);opacity:.45;transition:opacity .3s}
.mc-tag circle{fill:#fff;stroke:var(--verde);stroke-width:2.5;transition:fill .3s}
.mc-tag text{font:400 20px var(--f-display);fill:var(--verde)}
.mc-reg{cursor:pointer}
.mc-reg.on .mc-pt{opacity:1;fill:var(--terracotta)}
.mc-reg.on .mc-tag circle{fill:#E3B458}
.mc-scheda{background:#fff;border:1px solid rgba(0,59,31,.14);border-radius:18px;padding:18px 20px}
.mc-info:not([hidden]){animation:mcIn .35s ease}
@keyframes mcIn{from{opacity:0}}
.mc-info h3{font-size:28px}
.mc-info p{margin:6px 0}
.mc-posti{font-weight:700;color:var(--terracotta)}
.mc-info ul{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:4px;font-size:17px}
.mc-info ul span{font-weight:700;color:var(--muted)}
.mc-sez{padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px)}
.mc-fid{background:var(--carta)}
.mc-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:var(--muted);border-top:1px solid rgba(0,59,31,.15);font-size:16px}
.mc-piede span{font:400 32px/1 var(--f-display);color:var(--verde)}
.mc-piede p{margin:0}
@media (max-width:860px){.mc-hero{grid-template-columns:1fr}.mc-carta{position:static}.mc-carta svg{max-height:none}}
</style>
<script>
  const radice = document.querySelector('.p-mc');
  if (radice) {
    const bottoni = [...radice.querySelectorAll<HTMLButtonElement>('.mc-zona')];
    const regioni = [...radice.querySelectorAll<SVGGElement>('.mc-reg')];
    const info = [...radice.querySelectorAll<HTMLElement>('.mc-info')];
    const scegli = (id: string) => {
      bottoni.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.zona === id)));
      regioni.forEach((r) => r.classList.toggle('on', r.dataset.zona === id));
      info.forEach((i) => (i.hidden = i.dataset.info !== id));
    };
    bottoni.forEach((b) => b.addEventListener('click', () => scegli(b.dataset.zona!)));
    regioni.forEach((r) => r.addEventListener('click', () => scegli(r.dataset.zona!)));
    scegli(bottoni[0].dataset.zona!);
  }
</script>
