---
// Proposta J: La mappa piegata. Una vecchia carta stradale che si spiega in 3D, pannello dopo pannello.
import { RECENSIONI, CITAZIONE } from '../../data/recensioni';
import { ITALIA_PATH, ITALIA_W, ITALIA_H } from '../../data/italia';
import { ZONE_MAPPA, NOMI, NOMI_KEY, xy, percorso, VIAGGIO } from '../../data/zone';
import Testata from '../../components/Testata.astro';
import BottoniContatto from '../../components/BottoniContatto.astro';
import Icona from '../../components/Icona.astro';
import T from '../../components/T.astro';
const rec = RECENSIONI[0];
const [soraX, soraY] = xy('sora');
const [pugX, pugY] = xy('alberobello');
const mappa = `
  <defs><pattern id="piGriglia" width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0H0V30" fill="none" stroke="#C9B99A" stroke-width=".6"/></pattern></defs>
  <rect x="-200" y="-200" width="1000" height="1120" fill="url(#piGriglia)"/>
  <path d="${ITALIA_PATH}" fill="#E4EADF" stroke="#003B1F" stroke-width="1.6" stroke-linejoin="round"/>
  <circle cx="${pugX}" cy="${pugY}" r="62" fill="#E3B458" opacity=".28"/>
  <path class="pi-rotta" d="${percorso(VIAGGIO)}" fill="none" stroke="#B04A2A" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 7"/>
  ${VIAGGIO.map((p) => { const [x, y] = xy(p); return `<g transform="translate(${x} ${y})"><circle r="5.5" fill="#FEF6EB" stroke="#003B1F" stroke-width="2.4"/><text x="9" y="4.5" font-family="DM Sans Variable, DM Sans, sans-serif" font-weight="700" font-size="${p === 'polignano' || p === 'alberobello' ? 11 : 13}" fill="#003B1F" paint-order="stroke" stroke="#F7EEDC" stroke-width="3">${NOMI_KEY[p] ? 'Firenze' : NOMI[p]}</text></g>`; }).join('')}
  <path transform="translate(${soraX} ${soraY - 20})" d="M0 -9 L2.6 -2.8 9 -2.8 3.8 1.2 5.8 7.6 0 3.8 -5.8 7.6 -3.8 1.2 -9 -2.8 -2.6 -2.8Z" fill="#B04A2A"/>
  <g transform="translate(470 90)" opacity=".85"><circle r="40" fill="none" stroke="#003B1F" stroke-width="1.4"/><path d="M0 -52 L8 0 0 52 -8 0Z" fill="#003B1F"/><path d="M-52 0 L0 -8 52 0 0 8Z" fill="#B04A2A" opacity=".8"/><text y="-58" text-anchor="middle" font-family="DM Serif Display, serif" font-size="16" fill="#003B1F">N</text></g>`;
---
<div class="p-pie">
  <Testata scura />
  <main id="contenuto">
    <section class="pi-scena">
      <div class="pi-testa">
        <T as="h2" k="pie.h" />
      </div>
      <div class="pi-tavolo">
        <div class="pi-mappa" id="piMappa" data-aperta="false">
          <div class="pi-p pi-p1">
            <div class="pi-faccia pi-fronte">
              <img class="pi-stef" src="/img/stefano.webp" width="458" height="640" alt="" />
              <h1>Stefano In Italy</h1>
              <T as="p" class="pi-ruolo" k="tag.role" />
              <T as="p" class="pi-testo" k="intro.lead" />
              <div class="pi-legenda">
                <T as="h3" k="pie.legend" />
                <p><span class="pi-l pi-l1"></span><T k="pie.leg.1" /></p>
                <p><span class="pi-l pi-l2"></span><T k="pie.leg.2" /></p>
                <p><span class="pi-l pi-l3">★</span><T k="pie.leg.3" /></p>
              </div>
            </div>
            <div class="pi-faccia pi-retro"></div>
            <div class="pi-p pi-p2">
              <div class="pi-faccia pi-fronte pi-mezza"><svg viewBox={`-30 -30 ${ITALIA_W + 60} ${ITALIA_H + 60}`} set:html={mappa} /></div>
              <div class="pi-faccia pi-retro"></div>
              <div class="pi-p pi-p3">
                <div class="pi-faccia pi-fronte pi-mezza pi-mezza-2"><svg viewBox={`-30 -30 ${ITALIA_W + 60} ${ITALIA_H + 60}`} set:html={mappa} /></div>
                <div class="pi-faccia pi-retro"></div>
                <div class="pi-p pi-p4">
                  <div class="pi-faccia pi-fronte pi-ultimo" id="contatti">
                    <T as="h3" k="rev.h" />
                    <div class="pi-stelle" aria-label="5/5">{[1, 2, 3, 4, 5].map(() => <Icona nome="stella" />)}</div>
                    <p class="pi-cit">“{CITAZIONE.titolo}”</p>
                    <T as="p" class="pi-fonte" k="rev.quote.src" />
                    <a class="pi-link" href={rec.img} target="_blank" rel="noopener"><T k="rev.open" /> →</a>
                    <hr />
                    <T as="h3" k="col.h" />
                    <BottoniContatto email={false} class="pi-btn" />
                  </div>
                  <div class="pi-faccia pi-retro pi-copertina" role="button" tabindex="0" aria-label="Unfold the map" data-i18n-aria="pie.open">
                    <span class="pi-cop-sii">SII!</span>
                    <svg class="pi-cop-italia" viewBox={`0 0 ${ITALIA_W} ${ITALIA_H}`} aria-hidden="true"><path d={ITALIA_PATH} /></svg>
                    <span class="pi-cop-nome">Stefano In Italy</span>
                    <T class="pi-cop-sotto" k="pie.cover" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button type="button" class="pi-apri" id="piApri"><T k="pie.open" data-stato="chiusa" /><T k="pie.close" data-stato="aperta" hidden /></button>
    </section>
  </main>
  <footer class="pi-piede wrap"><span>SII!</span><T as="p" k="foot" /></footer>
</div>

<style is:global>
html[data-tema="piegata"] body{background:var(--verde);color:var(--crema)}
.p-pie{overflow-x:clip;--W:min(23vw,290px);--H:min(72vh,590px);--asse:Y;--dur:.9s}
.pi-scena{min-height:calc(100dvh - 60px);display:grid;justify-items:center;align-content:center;gap:20px;padding:24px var(--pad) 40px}
.pi-testa h2{font-size:clamp(28px,4vw,48px);text-align:center;color:var(--crema)}
.pi-tavolo{perspective:2200px;width:100%;display:flex;justify-content:center}
.pi-mappa{position:relative;width:calc(var(--W) * 4);height:var(--H);transform:translateX(calc(var(--W) * 1.5));transition:transform var(--dur) cubic-bezier(.5,0,.2,1) 0s;transform-style:preserve-3d}
.pi-mappa[data-aperta="true"]{transform:none}
.pi-p{position:absolute;top:0;left:0;width:var(--W);height:var(--H);transform-style:preserve-3d;transform-origin:left center;transition:transform var(--dur) cubic-bezier(.6,0,.25,1)}
.pi-p1{position:relative}
.pi-p .pi-p{left:100%}
.pi-mappa[data-aperta="false"] .pi-p2{transform:rotateY(-179.4deg)}
.pi-mappa[data-aperta="false"] .pi-p3{transform:rotateY(179.4deg)}
.pi-mappa[data-aperta="false"] .pi-p4{transform:rotateY(-179.4deg)}
.pi-mappa[data-aperta="true"] .pi-p2{transition-delay:.15s}
.pi-mappa[data-aperta="true"] .pi-p3{transition-delay:.75s}
.pi-mappa[data-aperta="true"] .pi-p4{transition-delay:1.35s}
.pi-mappa[data-aperta="false"] .pi-p2{transition-delay:1.2s}
.pi-mappa[data-aperta="false"] .pi-p3{transition-delay:.6s}
.pi-faccia{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden;background:#F7EEDC;color:var(--verde)}
.pi-fronte{background-image:linear-gradient(90deg,rgba(0,0,0,.07),transparent 10%,transparent 90%,rgba(0,0,0,.05));box-shadow:0 0 0 .5px rgba(0,0,0,.06)}
.pi-retro{transform:rotateY(180deg);background:#EADBBE repeating-linear-gradient(45deg,transparent 0 14px,rgba(176,74,42,.07) 14px 15px)}
.pi-p1>.pi-fronte{padding:clamp(16px,2vw,26px);display:flex;flex-direction:column;gap:8px}
.pi-stef{width:42%;height:auto;align-self:center;background:var(--verde);border-radius:50%;padding:8px 8px 0;aspect-ratio:1;object-fit:contain;object-position:bottom}
.p-pie h1{font-size:clamp(26px,2.4vw,34px);text-align:center;color:var(--verde)}
.pi-ruolo{margin:0;text-align:center;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--terracotta)}
.pi-testo{margin:4px 0 0;font:400 clamp(14px,1.2vw,17px)/1.35 var(--f-display);text-align:center}
.pi-legenda{margin-top:auto;border:1.5px solid var(--verde);padding:10px 12px;font-size:13px}
.pi-legenda h3{font-size:16px;margin-bottom:6px;font-family:var(--f-sans);font-weight:700;text-transform:uppercase;letter-spacing:.1em}
.pi-legenda p{margin:3px 0;display:flex;align-items:center;gap:8px}
.pi-l{width:14px;height:14px;flex:none;display:inline-grid;place-items:center}
.pi-l1{border-radius:50%;background:#FEF6EB;border:2.4px solid var(--verde)}
.pi-l2{border-radius:50%;background:rgba(227,180,88,.5)}
.pi-l3{color:var(--terracotta);font-size:16px}
.pi-mezza svg{position:absolute;top:0;left:0;width:200%;height:100%}
.pi-mezza-2 svg{left:-100%}
.pi-ultimo{padding:clamp(16px,2vw,24px);display:flex;flex-direction:column;gap:6px}
.pi-ultimo h3{font-size:clamp(20px,1.8vw,26px)}
.pi-stelle{display:flex;gap:2px;color:#C98E2B}
.pi-stelle svg{width:20px;height:20px}
.pi-cit{margin:0;font:italic 400 clamp(17px,1.5vw,21px)/1.2 var(--f-display)}
.pi-fonte{margin:0;font-size:12px;font-weight:700;color:var(--muted)}
.pi-link{font-size:13px;font-weight:700}
.pi-ultimo hr{border:0;border-top:1.5px solid rgba(0,59,31,.2);width:100%;margin:6px 0}
.pi-btn{flex-direction:column;gap:8px}
.pi-btn .btn{min-height:44px;padding:8px 14px;font-size:14px}
.pi-copertina{background:var(--verde);color:var(--crema);display:grid;grid-template-rows:auto 1fr auto auto;justify-items:center;align-items:center;padding:22px 16px;text-align:center;cursor:pointer;border:6px solid #0F5233;background-image:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.025) 3px 4px)}
.pi-cop-sii{font:400 clamp(40px,4vw,60px)/1 var(--f-display);border-bottom:2px solid #E3B458;padding-bottom:6px}
.pi-cop-italia{width:70%;height:auto;max-height:100%}
.pi-cop-italia path{fill:none;stroke:#E3B458;stroke-width:3}
.pi-cop-nome{font:400 clamp(22px,2vw,28px)/1.1 var(--f-display)}
.pi-cop-sotto{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#C9D6C6;margin-top:6px}
.pi-copertina:focus-visible{outline:3px solid #E3B458;outline-offset:-10px}
.pi-apri{appearance:none;border:0;background:var(--crema);color:var(--verde);font:700 17px/1 var(--f-sans);padding:16px 28px;border-radius:999px;cursor:pointer;box-shadow:0 10px 24px rgba(0,0,0,.25);transition:transform .2s}
.pi-apri:hover{transform:translateY(-2px)}
.pi-mappa[data-aperta="false"]{animation:piRespira 3.2s ease-in-out infinite}
@keyframes piRespira{50%{translate:0 -8px}}
.pi-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:#C9D6C6;border-top:1px solid rgba(254,246,235,.15)}
.pi-piede span{font:400 32px/1 var(--f-display);color:var(--crema)}
.pi-piede p{margin:0}
/* telefono: la mappa si spiega dall'alto in basso */
@media (max-width:760px){
  .p-pie{--W:min(calc(100vw - 32px),380px);--H:480px}
  .pi-mappa{width:var(--W);height:calc(var(--H) * 4);transform:none;transition:height var(--dur)}
  .pi-mappa[data-aperta="false"]{height:var(--H)}
  .pi-p{transform-origin:center top}
  .pi-p .pi-p{left:0;top:100%}
  .pi-mappa[data-aperta="false"] .pi-p2{transform:rotateX(179.4deg)}
  .pi-mappa[data-aperta="false"] .pi-p3{transform:rotateX(-179.4deg)}
  .pi-mappa[data-aperta="false"] .pi-p4{transform:rotateX(179.4deg)}
  .pi-retro{transform:rotateX(180deg)}
  .pi-fronte{background-image:linear-gradient(rgba(0,0,0,.07),transparent 10%,transparent 90%,rgba(0,0,0,.05))}
  .pi-mezza svg{width:100%;height:200%}
  .pi-mezza-2 svg{left:0;top:-100%}
  .pi-stef{width:34%}
  .pi-apri{position:sticky;bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:5}
}
@media (prefers-reduced-motion:reduce){.p-pie{--dur:.01s}.pi-mappa{animation:none!important}}
</style>

<script>
  const mappa = document.getElementById('piMappa');
  if (mappa) {
    const bottone = document.getElementById('piApri')!;
    const imposta = (aperta: boolean) => {
      mappa.dataset.aperta = String(aperta);
      bottone.querySelectorAll<HTMLElement>('[data-stato]').forEach((s) => (s.hidden = (s.dataset.stato === 'aperta') !== aperta));
    };
    bottone.addEventListener('click', () => imposta(mappa.dataset.aperta !== 'true'));
    const cop = mappa.querySelector<HTMLElement>('.pi-copertina')!;
    cop.addEventListener('click', () => imposta(true));
    cop.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); imposta(true); } });
  }
</script>
