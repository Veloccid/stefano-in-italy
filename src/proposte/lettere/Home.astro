---
// Proposta M: Le lettere dei viaggiatori. Si apre con le recensioni: la fiducia prima di tutto.
import { RECENSIONI, CITAZIONE } from '../../data/recensioni';
import { TAPPE, LINGUE_PARLATE } from '../../data/curriculum';
import Testata from '../../components/Testata.astro';
import ContattiChiari from '../../components/ContattiChiari.astro';
import Icona from '../../components/Icona.astro';
import T from '../../components/T.astro';
const vera = RECENSIONI[0];
---
<div class="p-let">
  <Testata />
  <main id="contenuto">
    <section class="le-hero wrap">
      <div class="le-stelle" aria-label="5/5">{[1, 2, 3, 4, 5].map(() => <Icona nome="stella" />)}</div>
      <blockquote class="le-cit">“{CITAZIONE.testo}”</blockquote>
      <T as="p" class="le-fonte" k="rev.quote.src" />
      <div class="le-firma">
        <img src="/img/stefano.webp" width="458" height="640" alt="" />
        <div><h1>Stefano Alonzi</h1><T as="p" k="tag.role" /></div>
      </div>
    </section>

    <section class="le-muro" id="recensioni">
      <div class="wrap">
        <T as="h2" k="fid.lettere" />
        <T as="p" class="le-intro" k="fid.p" />
        <div class="le-griglia">
          <a class="le-foglio le-vera" href={vera.img} target="_blank" rel="noopener">
            <img src={vera.img} width={vera.w} height={vera.h} loading="lazy" alt={`Verified review on ${vera.fonte}`} />
            <span><Icona nome="spunta" /> {vera.fonte}</span>
          </a>
          {[0, 1, 2, 3, 4].map(() => <div class="le-foglio le-vuoto"><span class="le-righe" aria-hidden="true"></span><T k="fid.lettera" /></div>)}
        </div>
        <T as="p" class="le-nota" k="fid.tutte" />
      </div>
    </section>

    <section class="le-dossier wrap">
      <div>
        <T as="h2" k="intro.h" />
        <T as="p" class="le-lead" k="intro.lead" />
        <T as="p" k="intro.p1" />
      </div>
      <dl class="le-dati">
        <div><dt><T k="f.lang" /></dt><dd>{LINGUE_PARLATE.map((k) => <T as="span" k={k} />)}</dd></div>
        <div><dt><T k="nav.cv" /></dt><dd>{TAPPE.slice(0, 3).map((t) => <span><b>{t.anni}</b> <T k={`cv.${t.n}.h`} /></span>)}</dd></div>
        <div><dt>&nbsp;</dt><dd><a href="#curriculum" data-cv-open class="le-cv"><T k="cv.open" /> →</a></dd></div>
      </dl>
    </section>

    <section class="le-ct" id="contatti"><div class="wrap"><ContattiChiari /></div></section>
  </main>
  <footer class="le-piede wrap"><span>SII!</span><T as="p" k="foot" /></footer>
</div>
<style is:global>
.p-let{font-size:19px;line-height:1.6}
.le-hero{padding-top:clamp(40px,7vw,96px);padding-bottom:clamp(40px,6vw,80px);display:grid;gap:16px;max-width:980px}
.le-stelle{display:flex;gap:6px;color:var(--ocra)}
.le-stelle svg{width:34px;height:34px}
.le-cit{margin:0;font:400 clamp(34px,5.4vw,68px)/1.12 var(--f-display);text-wrap:balance}
.le-fonte{margin:0;font-weight:700;color:var(--muted)}
.le-firma{display:flex;align-items:center;gap:16px;margin-top:20px;padding-top:20px;border-top:2px solid var(--verde)}
.le-firma img{width:72px;height:72px;object-fit:cover;object-position:top;border-radius:50%;background:var(--verde);padding:6px 6px 0}
.le-firma h1{font-size:30px}
.le-firma p{margin:0;font-size:15px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--terracotta)}
.le-muro{background:var(--verde);color:var(--crema);padding:clamp(56px,8vw,96px) 0}
.le-muro h2{font-size:clamp(34px,4.6vw,56px)}
.le-intro{color:#DDE6D5;max-width:56ch}
.le-griglia{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.le-foglio{background:#FBF3E4;color:var(--verde);border-radius:6px;min-height:240px;box-shadow:0 10px 24px rgba(0,0,0,.18);text-decoration:none;position:relative;overflow:hidden}
.le-vera{grid-row:span 2;display:flex;flex-direction:column;background:#fff}
.le-vera img{width:100%;height:auto;flex:1;object-fit:cover;object-position:top}
.le-vera span{display:flex;align-items:center;gap:8px;padding:10px 14px;font-size:15px;font-weight:700}
.le-vera svg{width:18px;height:18px}
.le-vuoto{display:grid;place-items:center;text-align:center;padding:24px;color:var(--muted);font-size:16px}
.le-righe{position:absolute;inset:28px 22px;background:repeating-linear-gradient(transparent 0 27px,rgba(0,59,31,.12) 27px 28px)}
.le-vuoto>:not(.le-righe){position:relative;background:#FBF3E4;padding:4px 8px}
.le-nota{color:#C9D6C6;font-size:15px;margin-top:20px}
.le-dossier{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(28px,5vw,64px);padding-top:clamp(56px,8vw,96px);padding-bottom:clamp(56px,8vw,96px)}
.le-dossier h2{font-size:clamp(32px,4.4vw,52px);margin-bottom:10px}
.le-lead{font:400 clamp(21px,2.3vw,26px)/1.35 var(--f-display)}
.le-dati{margin:0;display:grid;gap:18px;align-content:start}
.le-dati div{display:grid;gap:4px;border-top:1px solid rgba(0,59,31,.2);padding-top:12px}
.le-dati dt{font-size:14px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--terracotta)}
.le-dati dd{margin:0;display:grid;gap:4px}
.le-dati b{color:var(--muted)}
.le-cv{font-weight:700}
.le-ct{background:var(--carta);padding:clamp(56px,8vw,96px) 0}
.le-piede{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding-top:24px;padding-bottom:110px;color:var(--muted);font-size:16px}
.le-piede span{font:400 32px/1 var(--f-display);color:var(--verde)}
.le-piede p{margin:0}
@media (max-width:860px){.le-griglia{grid-template-columns:1fr 1fr}.le-vera{grid-column:span 2;grid-row:auto}.le-vera img{max-height:420px}.le-dossier{grid-template-columns:1fr}}
@media (max-width:520px){.le-griglia{grid-template-columns:1fr}.le-vera{grid-column:auto}.le-foglio.le-vuoto:nth-of-type(n+4){display:none}}
</style>
